---
import '@fontsource-variable/big-shoulders-display';
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Pic from '../components/Pic.astro';
import idx from '../data/tisch/arbeiten-index.json';
import meta from '../data/imgmeta.json';
import { T as RT } from '../data/reportage';
import { site, routes, campaignPath, type Lang } from '../data/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const u = (p: string) => base + p;
const r = (k: keyof typeof routes) => routes[k][lang];

const T = {
  de: {
    title: 'Porträtfotografie Köln · Künstlerporträts, Musik, Kampagnen · Kilian Amrehn',
    description: 'Kilian Amrehn, Fotograf in Köln: Künstlerporträts, Musikporträts, Pressefotos für Bands, Album- und Plattencover, Schauspielporträts, Kampagnen und freie Strecken. Gerichtetes Licht, keine Pose.',
    h1: 'Porträtfotografie für Artists · Köln',
    claim: 'Licht,<br><span>das sucht.</span>',
    chips: 'Licht wählen',
    looks: {
      rock: { caption: 'Rock Fairyland · Marie und Louis', alt: 'Rock Fairyland, Marie und Louis in Tüll, Schwarzweiß, Editorial von Kilian Amrehn', label: 'Weißes Licht' },
      scholl: { caption: 'Scholl Comfort · Ägypten', alt: 'Scholl Comfort Kampagne, Model in weißem Kleid zwischen schrägen Wänden', label: 'Sandfarbenes Licht' },
      pc: { caption: 'Peek & Cloppenburg x Ellesse', alt: 'Peek und Cloppenburg x Ellesse Kampagne, junge Frau in der Straßenbahn bei Nacht', label: 'Gelbes Licht' },
      trish: { caption: 'Reflections of Identity', alt: 'Trish vor einem offenen Kühlschrank im türkisen Licht', label: 'Türkises Licht' },
      bianca: { caption: 'Bianca Berding', alt: 'Bianca Berding mit mintgrünem Hut, Moderationsporträt Köln', label: 'Mintgrünes Licht' },
      morley: { caption: 'Morley', alt: 'Morley, drei Musikerinnen von oben, Pressefoto für Bands Köln', label: 'Goldenes Licht' },
      slavko: { caption: 'Slavko Popadic', alt: 'Slavko Popadic, Schauspielporträt Köln, Blick in die Kamera', label: 'Kühles Licht' },
    },
    eyes: [
      'Augen, Slavko Popadic, Blick in die Kamera',
      'Augen, Juliette, Blick aus dem Dunkel',
      'Augen, Paula, im türkisen Licht',
      'Augen, Jeremiah, mit Haarsträhne über dem Gesicht',
      'Augen, Lea Mende, im roten Licht',
    ],
    strips: 'Arbeiten auf Negativstreifen',
    stripsHead: ['Ausschnitte', ''],
    stripAlt: 'Negativstreifen mit Porträts und Kampagnen von Kilian Amrehn',
    runon: '<em>Artistporträts Köln</em> · Musikporträts · Pressefotos für Bands und Solo-Artists · EP- und Albumcover · Schauspielporträts · <em>gerichtetes Licht</em> · farbiges Licht · Dunkelheit, die etwas verbirgt · <em>ein Blick direkt in die Kamera</em> · eine Bewegung, festgehalten, obwohl sie weitergeht · <b>keine Pose</b> · Köln, Berlin, weltweit · <em>Slavko Popadic</em> · <em>Bianca Berding</em> · <em>Peek &amp; Cloppenburg</em> · <em>Copenhagen Studios</em> · <em>Bundesliga</em> · Menschen so zeigen, wie sie sich selbst noch nicht gesehen haben.',
    doorArtists: ['Porträts', 'Porträt · Musik · Schauspiel · Kunst'],
    doorCampaigns: ['Arbeiten', 'Kampagnen &amp; freie Strecken'],
    clipTop: 'Köln',
    newsTitle: site.newsTitle,
    clipAlt: 'Eine Mutter mit Baby auf dem Arm und ihrem Kind an der Hand, Moldau 2022',
    clipKicker: 'Flucht · Moldau 2022',
    clipHead: 'Das ärmste Land Europas öffnet seine Grenze',
    clipPlace: 'Moldau, 2022 ·',
    clipText: 'Was bleibt, ist ein Gefühl. Das Gefühl, dass wir nicht genug tun und sie nicht genug haben. Nach einem Tag in Flüchtlingslagern, an der Grenze zur Ukraine, in Gesprächen mit Geflüchteten und in Lagerhallen bin ich vor allem beeindruckt.',
  },
  en: {
    title: 'Portrait Photography Cologne · Artists, Music, Campaigns · Kilian Amrehn',
    description: 'Kilian Amrehn, photographer in Cologne: artist portraits, music portraits, band press photos, album and record covers, actor portraits, campaigns and personal series. Directed light, no posing.',
    h1: 'Portrait photography for artists · Cologne',
    claim: 'Light<br><span>that searches.</span>',
    chips: 'Choose the light',
    looks: {
      rock: { caption: 'Rock Fairyland · Marie and Louis', alt: 'Rock Fairyland, Marie and Louis in tulle, black and white editorial by Kilian Amrehn', label: 'White light' },
      scholl: { caption: 'Scholl Comfort · Egypt', alt: 'Scholl Comfort campaign, model in a white dress between slanted walls', label: 'Sand-coloured light' },
      pc: { caption: 'Peek & Cloppenburg x Ellesse', alt: 'Peek and Cloppenburg x Ellesse campaign, young woman on a tram at night', label: 'Yellow light' },
      trish: { caption: 'Reflections of Identity', alt: 'Trish in front of an open fridge in turquoise light', label: 'Turquoise light' },
      bianca: { caption: 'Bianca Berding', alt: 'Bianca Berding in a mint green hat, presenter portrait Cologne', label: 'Mint light' },
      morley: { caption: 'Morley', alt: 'Morley, three musicians seen from above, band press photo Cologne', label: 'Golden light' },
      slavko: { caption: 'Slavko Popadic', alt: 'Slavko Popadic, actor portrait Cologne, looking into the camera', label: 'Cool light' },
    },
    eyes: [
      'Eyes, Slavko Popadic, looking into the camera',
      'Eyes, Juliette, looking out of the dark',
      'Eyes, Paula, in turquoise light',
      'Eyes, Jeremiah, with a strand of hair across the face',
      'Eyes, Lea Mende, in red light',
    ],
    strips: 'Work on negative strips',
    stripsHead: ['Excerpts', ''],
    stripAlt: 'Negative strips with portraits and campaigns by Kilian Amrehn',
    runon: '<em>Artist portraits Cologne</em> · music portraits · press photos for bands and solo artists · EP and album covers · actor portraits · <em>directed light</em> · coloured light · darkness that hides something · <em>a look straight into the camera</em> · a movement, held still while it carries on · <b>no posing</b> · Cologne, Berlin, worldwide · <em>Slavko Popadic</em> · <em>Bianca Berding</em> · <em>Peek &amp; Cloppenburg</em> · <em>Copenhagen Studios</em> · <em>Bundesliga</em> · showing people the way they have never seen themselves.',
    doorArtists: ['Portraits', 'Portrait · Music · Acting · Art'],
    doorCampaigns: ['Work', 'Campaigns &amp; personal series'],
    clipTop: 'Cologne',
    newsTitle: site.newsTitleEn,
    clipAlt: 'A mother with a baby in her arms and her child by the hand, Moldova 2022',
    clipKicker: 'Refugees · Moldova 2022',
    clipHead: 'Europe’s poorest country opens its border',
    clipPlace: 'Moldova, 2022 ·',
    clipText: 'What remains is a feeling. The feeling that we are not doing enough and they do not have enough. After a day in refugee camps, at the border with Ukraine, talking with refugees and in warehouses, I am above all impressed.',
  },
};
const t = T[lang];

const looks = [
  { k: 'rock', src: 'hero-rock-fairyland', bg: '#0e0e0e', dot: '#ece8e1' },
  { k: 'scholl', src: 'hero-scholl', bg: '#140d09', dot: '#7a5644' },
  { k: 'pc', src: 'hero-peek-cloppenburg-ellesse', bg: '#120f06', dot: '#e8c45a' },
  { k: 'trish', src: 'hero-trish', bg: '#041312', dot: '#39c6be' },
  { k: 'bianca', src: 'hero-bianca-berding', bg: '#13110d', dot: '#a9c7ae' },
  { k: 'morley', src: 'hero-morley', bg: '#150e06', dot: '#b98a52' },
  { k: 'slavko', src: 'hero-slavko-popadic', bg: '#0c0e10', dot: '#7c8a99' },
].map((l) => ({ ...l, ...t.looks[l.k as keyof typeof t.looks] }));
const EYES: [string, string, string][] = [
  ['lea-mende-3', 'Lea Mende', 'lea-mende'], ['flo-wuensche-schauspiel-1', 'Flo Wünsche', ''], ['paula-dj-2', 'Paula', 'paula'],
  ['salome-schauspielerin-1', 'Salomé', 'salome'], ['pia-stutzenstein-schauspielerin-2', 'Pia Stutzenstein', 'pia-stutzenstein'], ['nicole-malerin-kuenstlerinnenportraet-3', 'Nicole', 'nicole'],
  ['zahnatzin-dj-2', 'Zahnatzin', 'zahnatzin'], ['david-vormweg-schauspieler-1', 'David Vormweg', 'david-vormweg'], ['portraet-koeln-4', '', ''],
  ['parzhuber-trio-band-2', 'Parzhuber Trio', 'parzhuber-trio'], ['nicole-da-silva-musikerin-1', 'Nicole Da Silva', 'nicole-da-silva'], ['bianca-berding-moderatorin-1', 'Bianca Berding', 'bianca-berding'],
  ['paulus-goerden-2', 'Paulus Goerden', 'paulus-goerden'], ['portraet-koeln-2', '', ''], ['simon-und-quartett-band-2', 'Simon und Quartett', 'simon-und-quartett'],
  ['slavko-popadic-3', 'Slavko Popadic', 'slavko-popadic'], ['portraet-koeln-1', '', ''],
];
// Beim Aufklappen: ganze Bilder (Querformat allein, Hochformat mit weiteren Bildern derselben Person)
const FULL: Record<string, string[]> = {
  'lea-mende-3': ['lea-mende-3'], 'flo-wuensche-schauspiel-1': ['flo-wuensche-schauspiel-1'], 'paula-dj-2': ['paula-dj-1', 'paula-dj-2', 'paula-dj-3'],
  'salome-schauspielerin-1': ['salome-schauspielerin-1'], 'pia-stutzenstein-schauspielerin-2': ['pia-stutzenstein-schauspielerin-2'],
  'nicole-malerin-kuenstlerinnenportraet-3': ['nicole-malerin-kuenstlerinnenportraet-1', 'nicole-malerin-kuenstlerinnenportraet-3', 'nicole-malerin-kuenstlerinnenportraet-2'],
  'zahnatzin-dj-2': ['zahnatzin-dj-1', 'zahnatzin-dj-2', 'zahnatzin-dj-3'], 'david-vormweg-schauspieler-1': ['david-vormweg-schauspieler-1', 'david-vormweg-schauspieler-2'],
  'portraet-koeln-4': ['portraet-koeln-4'], 'parzhuber-trio-band-2': ['parzhuber-trio-band-2'], 'nicole-da-silva-musikerin-1': ['nicole-da-silva-musikerin-1', 'nicole-da-silva-musikerin-2'],
  'bianca-berding-moderatorin-1': ['bianca-berding-moderatorin-1'], 'paulus-goerden-2': ['paulus-goerden-3', 'paulus-goerden-2', 'paulus-goerden-4'],
  'portraet-koeln-2': ['portraet-koeln-2'], 'simon-und-quartett-band-2': ['simon-und-quartett-band-2'], 'slavko-popadic-3': ['slavko-popadic-3'], 'portraet-koeln-1': ['portraet-koeln-1'],
};
const pmeta = import.meta.glob<{ default: { width: number; height: number } }>('/src/assets/img/p-*.jpg', { eager: true });
const eyes = EYES.map(([f, name, id]) => {
  const full = (FULL[f] ?? [f]).map((n) => { const m = pmeta[`/src/assets/img/p-${n}.jpg`].default; return { src: 'p-' + n, ar: m.width / m.height }; });
  const tot = full.reduce((a, x) => a + x.ar, 0), box = Math.max(tot, 1.5);
  return { id, name: name || (lang === 'de' ? 'Porträt' : 'Portrait'), src: 'eyes-' + f, full: full.map((x) => ({ ...x, pct: (100 * x.ar) / box })), box, alt: (lang === 'de' ? 'Augen, ' : 'Eyes, ') + (name || (lang === 'de' ? 'Porträt Köln' : 'portrait Cologne')) };
});
const ink = (hex: string) => { const n = parseInt(hex.slice(1), 16); const l = (0.299 * (n >> 16) + 0.587 * ((n >> 8) & 255) + 0.114 * (n & 255)) / 255; return l > 0.6; };
const bands = (idx as any[]).map((k) => { const ims = (k.bandImgs as string[]).map((n) => ({ n, ar: (meta as any)[n][0] / (meta as any)[n][1] })); return { n: k.title, c: k.band, light: ink(k.band), ims, ar: ims.reduce((a, i) => a + i.ar, 0), href: campaignPath(k.slug, lang) }; });
---
<Base lang={lang} alternate={routes.home[lang === 'de' ? 'en' : 'de']} title={t.title} description={t.description} headerOverlay image="/media/making-of-poster.jpg">
<section class="hero" data-hero style={`background:${looks[0].bg}`}>
  <div class="frame">
  {looks.map((l, i) => (
    <div class="look" data-look={l.k} data-bg={l.bg} data-caption={l.caption} hidden={i !== 0}>
      <Img src={l.src} alt="" widths={[960, 1440, 1920, 2880]} sizes="(max-width: 700px) 100vw, min(100vw, 150svh)" quality={84} class="cover base" loading={i === 0 ? 'eager' : 'lazy'} />
      <Img src={l.src} alt={l.alt} widths={[960, 1440, 1920, 2880]} sizes="(max-width: 700px) 100vw, min(100vw, 150svh)" quality={84} class="cover lit" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} />
    </div>
  ))}
  <canvas class="litc" aria-hidden="true"></canvas>
  <div class="shade"></div>
  <div class="tap-hint" aria-hidden="true"><svg viewBox="0 0 30 34" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle class="ring" cx="13" cy="7" r="6" /><path d="M13 8v13l-3-3a2 2 0 0 0-3 3l5 6c1.5 2 3 3 6 3h2a6 6 0 0 0 6-6v-6a2 2 0 0 0-4 0v-1a2 2 0 0 0-4 0v-1a2 2 0 0 0-4 0V8a1.5 1.5 0 0 0-3 0" /></svg></div>
  </div>
  <div class="hero-text wrap">
    <div>
      <h1 class="mono">{t.h1}</h1>
      <p class="display claim" set:html={t.claim} />
    </div>
    <div class="chips-box">
      <span class="mono caption" data-caption-out>{looks[0].caption}</span>
      <div class="chips" role="group" aria-label={t.chips}>
        {looks.map((l, i) => <button type="button" data-pick={l.k} aria-label={l.label} aria-pressed={i === 0 ? 'true' : 'false'} style={`background:${l.dot}`}></button>)}
      </div>
    </div>
  </div>
</section>

<section class="strips" aria-label={t.strips}>
  <div class="wrap mono strips-head"><span>{t.stripsHead[0]}</span></div>
  <div class="strip-rows">
    {[['kontaktabzug-negativstreifen-1', 'a'], ['kontaktabzug-negativstreifen-2', 'b']].map(([s, d]) => (
      <div class={`row row-${d}`}>
        <Img src={s} alt={t.stripAlt} class="neg" sizes="(max-width: 720px) 3000px, 6000px" widths={[3000, 6000, 12000]} quality={62} />
        <Img src={s} alt="" class="neg" sizes="(max-width: 720px) 3000px, 6000px" widths={[3000, 6000, 12000]} quality={62} />
      </div>
    ))}
  </div>
</section>

<section class="wrap intro">
  <p class="runon" set:html={t.runon} />
</section>

<section class="wrap doors">
  <div class="door">
    <div class="stack">{eyes.map((e) => (
      <a class="reveal eye" href={u(r('artists')) + (e.id ? '#' + e.id : '')} style={`--ar:${e.box.toFixed(4)}`}>
        <Img src={e.src} alt={e.alt} sizes="(max-width: 900px) 100vw, 50vw" widths={[480, 800, 1200, 1600]} class="eye-crop" />
        <span class="eye-full">{e.full.map((x) => <span style={`flex:0 0 ${x.pct.toFixed(3)}%`}><Img src={x.src} alt={e.name} sizes={`(max-width: 900px) ${Math.round(x.pct)}vw, ${Math.round(x.pct / 2)}vw`} widths={[480, 800, 1200]} /></span>)}</span>
        <span class="mono rv-name">{e.name} <b class="arr">→</b></span>
      </a>
    ))}</div>
    <a class="door-label" href={u(r('artists'))}><span class="display">{t.doorArtists[0]}</span><span class="mono mute"><Fragment set:html={t.doorArtists[1]} /> <b class="arr">→</b></span></a>
  </div>
  <div class="door">
    <div class="stack mono">{bands.map((b) => (
      <a class={`reveal band${b.light ? ' light' : ''}`} href={u(b.href)} style={`background:${b.c};--ar:${b.ar.toFixed(4)}`}>
        <span class="band-imgs">{b.ims.map((i) => <span style={`flex:${i.ar.toFixed(4)}`}><Pic name={i.n} alt={b.n} sizes={`(max-width: 900px) ${Math.round(100 * i.ar / b.ar)}vw, ${Math.round(50 * i.ar / b.ar)}vw`} /></span>)}</span>
        <span class="band-name">{b.n} <b class="arr">→</b></span>
      </a>
    ))}</div>
    <a class="door-label" href={u(r('campaigns'))}><span class="display">{t.doorCampaigns[0]}</span><span class="mono mute"><Fragment set:html={t.doorCampaigns[1]} /> <b class="arr">→</b></span></a>
  </div>
</section>

<section class="wrap clip-wrap">
  <a href={u(r('reportage'))} class="clip">
    <div class="clip-top mono"><span>{site.newsIssue} · {t.clipTop} · <span data-today={lang}>{new Date().toLocaleDateString(lang === 'de' ? 'de-DE' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Berlin' })}</span></span><span>Reportage</span></div>
    <div class="clip-title">{t.newsTitle}</div>
    <div class="clip-tick mono"><span>{RT[lang].ticker}</span></div>
    <div class="rule2"></div>
    <div class="clip-secs mono">{(lang === 'de' ? ['Moldau', 'Myanmar', 'Thailand', 'Malaysia', 'Protest', 'Kairo'] : ['Moldova', 'Myanmar', 'Thailand', 'Malaysia', 'Protest', 'Cairo']).map((x, i) => <span data-go={['moldau', 'myanmar', 'thailand', 'malaysia', 'protest', 'kairo'][i]}>{x}</span>)}</div>
    <div class="clip-body">
      <Pic name="r-moldau-12" alt={t.clipAlt} class="clip-img" sizes="(max-width: 900px) 100vw, 55vw" />
      <div class="clip-text">
        <span class="mono red">{t.clipKicker}</span>
        <span class="clip-head">{t.clipHead}</span>
        <p><b class="mono">{t.clipPlace}</b> {t.clipText}</p>
      </div>
    </div>
  </a>
</section>
</Base>

<style>
  .hero { position: relative; height: min(100svh, 66.667vw); overflow: hidden; cursor: crosshair; transition: background-color .4s; }
  .frame { position: absolute; top: 0; bottom: 0; left: 50%; transform: translateX(-50%); width: min(100vw, 150svh); aspect-ratio: 3 / 2; }
  .look, .look :global(picture) { position: absolute; inset: 0; }
  .look :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .look[hidden] { display: none; }
  .hero :global(.base) { position: absolute; inset: 0; opacity: .07; }
  .litc { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .hero :global(.lit) { opacity: 0; position: absolute; inset: 0; -webkit-mask-image: var(--mask); mask-image: var(--mask); }
  .hero { --mask: radial-gradient(circle 125px at 56% 40%, #000 0%, #000 35%, transparent 100%); }
  .shade { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(180deg, rgba(34,16,15,.6) 0%, rgba(34,16,15,0) 26%, rgba(34,16,15,0) 55%, rgba(34,16,15,.9) 100%); }
  .hero-text { position: absolute; left: 0; right: 0; bottom: clamp(28px, 5vw, 52px); display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 28px; pointer-events: none; }
  .hero h1 { font-weight: 400; color: var(--mute2); margin-bottom: 18px; }
  .claim { font-size: clamp(64px, 10.4vw, 150px); line-height: .86; color: var(--white); }
  .claim :global(span) { color: var(--mute); }
  .chips-box { display: flex; flex-direction: column; align-items: flex-end; gap: 14px; pointer-events: auto; }
  .caption { color: var(--mute2); }
  .chips { display: flex; gap: 12px; }
  .chips button { width: 44px; height: 44px; border-radius: 999px; border: 1px solid rgba(244,238,228,.35); padding: 0; cursor: pointer; }
  .chips button[aria-pressed='true'] { border: 3px solid var(--white); }
  @media (hover: none) { .hero { cursor: default; } }
  .tap-hint { display: none; }
  @media (hover: none) {
    .tap-hint { display: flex; align-items: center; gap: 10px; position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); z-index: 3; pointer-events: none; color: var(--white); font: 500 11px/1 var(--f-mono); letter-spacing: .16em; text-transform: uppercase; text-shadow: 0 1px 10px rgba(0,0,0,.7); transition: opacity .4s; white-space: nowrap; }
    .tap-hint svg { width: 34px; height: 34px; animation: tap 1.6s ease-in-out infinite; }
    .tap-hint .ring { animation: ring 1.6s ease-out infinite; transform-origin: 13px 7px; }
    .hero.painted .tap-hint { opacity: 0; }
    .hero .frame { touch-action: none; }
    .hero, .hero * { -webkit-user-select: none; user-select: none; -webkit-touch-callout: none; }
    :global(html:has(.hero.painting)) { -webkit-user-select: none; user-select: none; }
  }
  @keyframes tap { 0%, 100% { transform: translateY(0); } 15% { transform: translateY(3px); } 30% { transform: translateY(0); } 45% { transform: translateY(3px); } 60% { transform: translateY(0); } }
  @keyframes ring { 0%, 10% { opacity: 0; transform: scale(.4); } 20% { opacity: .9; } 60%, 100% { opacity: 0; transform: scale(1.6); } }
  @media (max-width: 700px) {
    .hero { height: auto; overflow: visible; }
    .frame { position: relative; left: 0; transform: none; width: 100%; }
    .hero-text { position: relative; bottom: auto; padding-top: 22px; padding-bottom: 8px; }
    .shade { background: linear-gradient(180deg, rgba(34,16,15,.55) 0%, rgba(34,16,15,0) 35%); }
    .claim { font-size: clamp(54px, 16vw, 80px); }
    .hero-text { flex-direction: column; align-items: stretch; flex-wrap: nowrap; padding-top: 16px; gap: 34px; }
    .chips-box { order: -1; align-items: flex-start; gap: 12px; } .chips { flex-wrap: nowrap; justify-content: space-between; width: 100%; gap: 8px; } .chips button { width: 40px; height: 40px; flex: 0 0 auto; }
  }


  .strips { overflow: hidden; padding: 34px 0 40px; }
  .strips-head { display: flex; justify-content: space-between; gap: 24px; color: var(--mute); padding-top: 22px; padding-bottom: 18px; }
  .strip-rows { display: flex; flex-direction: column; gap: 26px; }
  .row { display: flex; width: max-content; animation: slide 107s linear infinite; will-change: transform; }
  .row-b { animation-duration: 127s; animation-direction: reverse; }
  .row :global(picture) { display: block; flex: none; }
  .row :global(.neg) { height: clamp(300px, 41.7vw, 600px); width: auto; max-width: none; }
  @keyframes slide { to { transform: translateX(-50%); } }

  .intro :global(.runon em), .intro :global(.runon b) { color: var(--dim); transition: color 1.2s ease; }
  .intro :global(.runon em.lit) { color: var(--white); }
  .intro :global(.runon b.lit) { color: var(--accent); }
  @media (prefers-reduced-motion: reduce) { .intro :global(.runon em) { color: var(--white); } .intro :global(.runon b) { color: var(--accent); } }
  .intro { padding-top: clamp(80px, 10vw, 140px); padding-bottom: clamp(80px, 10vw, 140px); }
  .doors { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; padding-bottom: 80px; }
  .door { display: flex; flex-direction: column; gap: 20px; }
  .stack { display: flex; flex-direction: column; gap: 4px; }
  .reveal { --h: clamp(52px, 5.3vw, 76px); position: relative; display: block; height: var(--h); overflow: hidden; transition: height .5s cubic-bezier(.2,.7,.2,1); }
  .reveal :global(picture) { position: absolute; inset: 0; display: block; }
  .reveal :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .8s cubic-bezier(.2,.7,.2,1); }
  .reveal .arr { color: var(--accent); }
  .rv-name { position: absolute; left: 16px; bottom: 12px; color: var(--white); opacity: 0; transform: translateY(6px); transition: opacity .3s, transform .3s; text-shadow: 0 1px 12px rgba(0,0,0,.6); }
  .stack { container-type: inline-size; }
  .eye-full { position: absolute; inset: 0; display: flex; justify-content: center; gap: 2px; background: var(--ink); opacity: 0; transition: opacity .45s; }
  .eye-full > span { position: relative; min-width: 0; }
  .eye :global(img) { transform: none !important; }
  .eye.open { height: calc(100cqw / var(--ar)); }
  .eye.open .eye-full { opacity: 1; }
  .rv-name { z-index: 2; }
  .band { color: var(--white); }
  .band.light { color: #16110e; }
  .band.light .band-name { text-shadow: none; transition: top .5s cubic-bezier(.2,.7,.2,1), color .3s; }
  .band.light.open .band-name { color: var(--white); text-shadow: 0 1px 12px rgba(0,0,0,.5); }
  .band :global(img) { transform: none !important; }
  .band-imgs { position: absolute; inset: 0; display: flex; gap: 2px; }
  .band-imgs > span { position: relative; min-width: 0; }
  .band :global(img) { opacity: 0; transition: opacity .45s, transform .8s cubic-bezier(.2,.7,.2,1); }
  .band-name { position: absolute; left: 20px; top: calc(var(--h) / 2); transform: translateY(-50%); z-index: 1; transition: top .5s cubic-bezier(.2,.7,.2,1); text-shadow: 0 1px 12px rgba(0,0,0,.5); }
  .band .arr { opacity: 0; transition: opacity .3s; }
  .reveal.open { height: clamp(200px, 50vw, 280px); }
  .reveal.open .rv-name { opacity: 1; transform: none; }
  .band.open { height: calc(100cqw / var(--ar)); }
  .band.open :global(img) { opacity: 1; }
  .band.open .band-name { top: calc(100% - 28px); }
  .band.open .arr { opacity: 1; }
  @media (hover: hover) {
    .reveal:hover, .reveal:focus-visible { height: clamp(200px, 19vw, 280px); }
    .reveal:hover :global(img) { transform: scale(1.03); }
    .reveal:hover .rv-name, .reveal:focus-visible .rv-name { opacity: 1; transform: none; }
    .band:hover, .band:focus-visible { height: calc(100cqw / var(--ar)); }
    .eye:hover, .eye:focus-visible { height: calc(100cqw / var(--ar)); }
    .eye:hover .eye-full, .eye:focus-visible .eye-full { opacity: 1; }
    .band:hover :global(img), .band:focus-visible :global(img) { opacity: 1; }
    .band:hover .band-name { top: calc(100% - 28px); }
    .band:hover .arr { opacity: 1; }
    .band.light:hover .band-name, .band.light:focus-visible .band-name { color: var(--white); text-shadow: 0 1px 12px rgba(0,0,0,.5); }
  }
  .door-label { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 20px; }
  .arr { font-weight: 400; color: var(--accent); display: inline-block; transition: transform .25s; }
  .door-label:hover .arr { transform: translateX(6px); }
  .door-label .display { transition: color .2s; }
  .door-label:hover .display { color: var(--accent); }
  .door-label .display { font-size: clamp(44px, 4.4vw, 64px); line-height: 1; }
  @media (max-width: 900px) { .doors { grid-template-columns: 1fr; gap: 48px; } }

  .clip-wrap { padding-top: 40px; padding-bottom: clamp(100px, 11vw, 160px); }
  .clip { display: block; transform: rotate(-.8deg); background: var(--news-paper); color: var(--news-ink); box-shadow: 0 30px 60px rgba(0,0,0,.55); padding: 28px clamp(18px, 2.5vw, 36px) 0; overflow: hidden; }
  .clip:hover { color: var(--news-ink); transform: rotate(-.4deg); transition: transform .3s; }
  .clip-top { display: flex; justify-content: space-between; gap: 16px; color: var(--news-mute); padding-bottom: 10px; border-bottom: 1px solid var(--news-ink); }
  .clip-title { font-family: var(--f-news); font-weight: 900; text-transform: uppercase; font-size: clamp(64px, 10.4vw, 150px); line-height: .92; text-align: center; padding: 8px 0 4px; }
  .rule2 { border-top: 3px solid var(--news-ink); border-bottom: 1px solid var(--news-ink); height: 3px; }
  .clip-body { display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(20px, 2.5vw, 36px); padding-top: 28px; padding-bottom: 28px; align-items: start; }
  .clip-body :global(.clip-img) { width: 100%; height: auto; display: block; filter: grayscale(1) contrast(1.08); }
  .clip-tick { background: var(--news-ink); color: var(--news-paper); white-space: nowrap; overflow: hidden; padding: 8px 0; margin: 6px 0 0; font-size: 12px; letter-spacing: .08em; }
  .clip-tick span { display: inline-block; padding-left: 100%; animation: cliptick 45s linear infinite; }
  @keyframes cliptick { to { transform: translateX(-100%); } }
  @media (prefers-reduced-motion: reduce) { .clip-tick span { animation: none; padding-left: 16px; } }
  .clip-secs { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 28px; padding: 10px 0; border-bottom: 1px solid var(--news-ink); }
  .clip-secs span:hover { color: var(--news-red); }
  .clip-text { display: flex; flex-direction: column; gap: 14px; }
  .red { color: var(--news-red); }
  .clip-head { font-family: var(--f-news); font-weight: 900; text-transform: uppercase; font-size: clamp(36px, 3.8vw, 54px); line-height: .95; }
  .clip-text p { font-size: 17px; line-height: 1.55; }
  @media (max-width: 900px) { .clip-body { grid-template-columns: 1fr; } }
</style>

<script>
  // Handy: erster Tipp klappt den Streifen auf, zweiter Tipp öffnet die Seite
  if (matchMedia('(hover: none)').matches) {
    document.querySelectorAll<HTMLAnchorElement>('.reveal').forEach((a) => a.addEventListener('click', (e) => {
      if (a.classList.contains('open')) return;
      e.preventDefault();
      document.querySelectorAll('.reveal.open').forEach((x) => x.classList.remove('open'));
      a.classList.add('open');
    }));
  }
  // Lauftext: Hervorhebungen leuchten erst auf, wenn man darüber scrollt
  const io2 = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('lit'); io2.unobserve(e.target); } }), { rootMargin: '0px 0px -12% 0px', threshold: 1 });
  document.querySelectorAll('.runon em, .runon b').forEach((el) => io2.observe(el));
  document.querySelectorAll<HTMLElement>('[data-go]').forEach((el) => el.addEventListener('click', (e) => {
    e.preventDefault(); const a = el.closest('a'); if (a) location.href = a.href + '#' + el.dataset.go;
  }));
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) {
    // Licht: Spur glimmt nach und verblasst in gut 3 Sekunden, um den Finger bzw. die Maus ein weicher Hof
    type P = { x: number; y: number; t: number | null };
    const LIFE = 3200;
    // Startpunkt des Lichts je Startbild: immer auf einem Gesicht
    const FACE: Record<string, [number, number]> = { rock: [41, 52], scholl: [47, 19], pc: [48, 31], trish: [39, 43], bianca: [55, 50], morley: [48, 31], slavko: [52, 36] };
    const startFor = (k: string): P[] => { const [fx, fy] = FACE[k] ?? [50, 40]; return [-9, -6, -3, 0].map((d) => ({ x: fx + d, y: fy + d * 0.6, t: null })); };
    let lookK = (hero.querySelector('.look:not([hidden])') as HTMLElement | null)?.dataset.look || 'rock';
    let pts: P[] = startFor(lookK), cur: P = { ...pts[pts.length - 1] };
    // Licht wird auf ein Canvas gezeichnet (flüssiger als CSS-Masken): weiche Lichtflecken, darin das Bild, darüber ein leichter Hof
    const cv = hero.querySelector<HTMLCanvasElement>('.litc')!;
    const cx = cv.getContext('2d')!;
    let raf = 0, cw = 0, ch = 0;
    const fit = () => { const fr = cv.parentElement as HTMLElement; const d = Math.min(2, devicePixelRatio || 1); cw = fr.clientWidth; ch = fr.clientHeight; cv.width = Math.round(cw * d); cv.height = Math.round(ch * d); cx.setTransform(d, 0, 0, d, 0, 0); };
    fit(); addEventListener('resize', () => { fit(); kick(); });
    const litImg = () => hero.querySelector<HTMLImageElement>('.look:not([hidden]) img.lit, .look:not([hidden]) .lit img');
    const fade = (u: number) => 0.5 + 0.5 * Math.cos(Math.PI * Math.min(1, Math.max(0, u)));
    const blob = (x: number, y: number, r: number, a: number) => { const g = cx.createRadialGradient(x, y, 0, x, y, r); g.addColorStop(0, `rgba(255,255,255,${a})`); g.addColorStop(0.35, `rgba(255,255,255,${a})`); g.addColorStop(1, 'rgba(255,255,255,0)'); cx.fillStyle = g; cx.beginPath(); cx.arc(x, y, r, 0, 6.2832); cx.fill(); };
    const draw = (now: number) => {
      const R = Math.min(cw, ch);
      pts = pts.filter((p) => p.t === null || now - p.t < LIFE);
      cx.globalCompositeOperation = 'source-over'; cx.clearRect(0, 0, cw, ch);
      for (const p of pts) { const a = p.t === null ? 1 : fade((now - p.t) / LIFE); if (a > 0.004) blob((p.x / 100) * cw, (p.y / 100) * ch, R * (0.08 + 0.1 * a), a); }
      const age = cur.t === null ? 0 : Math.min(1, (now - cur.t) / LIFE);
      const ca = 1 - (1 - fade(age)) * 0.6;
      blob((cur.x / 100) * cw, (cur.y / 100) * ch, R * 0.17, ca);
      const im = litImg();
      if (im && im.complete && im.naturalWidth) {
        cx.globalCompositeOperation = 'source-in';
        const s2 = Math.max(cw / im.naturalWidth, ch / im.naturalHeight), iw = im.naturalWidth * s2, ih = im.naturalHeight * s2;
        cx.drawImage(im, (cw - iw) / 2, (ch - ih) / 2, iw, ih);
        cx.globalCompositeOperation = 'screen';
        const gx = (cur.x / 100) * cw, gy = (cur.y / 100) * ch, ga = 0.16 * (1 - (1 - fade(age)) * 0.7);
        const g = cx.createRadialGradient(gx, gy, 0, gx, gy, R * 0.38); g.addColorStop(0, `rgba(255,250,240,${ga})`); g.addColorStop(1, 'rgba(255,250,240,0)');
        cx.fillStyle = g; cx.fillRect(0, 0, cw, ch);
        cx.globalCompositeOperation = 'source-over';
      } else { cx.clearRect(0, 0, cw, ch); }
      if (pts.some((p) => p.t !== null) || age < 1) raf = requestAnimationFrame(draw); else raf = 0;
    };
    hero.querySelectorAll('img.lit, .lit img').forEach((i) => i.addEventListener('load', () => kick()));
    const kick = () => { if (!raf) raf = requestAnimationFrame(draw); };
    requestAnimationFrame(draw);
    // Handy: auf dem Bild direkt mit dem Finger Licht malen; gescrollt wird unter dem Bild
    let painting = false;
    const frameEl = (hero.querySelector('.frame') as HTMLElement) || hero;
    frameEl.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'touch') return;
      painting = true; hero.classList.add('painting', 'painted'); e.preventDefault(); frameEl.setPointerCapture(e.pointerId);
    });
    const stop = () => { painting = false; hero.classList.remove('painting'); };
    frameEl.addEventListener('pointerup', stop);
    frameEl.addEventListener('pointercancel', stop);
    frameEl.addEventListener('touchstart', (e) => e.preventDefault(), { passive: false });
    frameEl.addEventListener('touchmove', (e) => e.preventDefault(), { passive: false });
    frameEl.addEventListener('contextmenu', (e) => e.preventDefault());
    document.addEventListener('selectstart', (e) => { if (painting) e.preventDefault(); });
    hero.addEventListener('pointermove', (e) => {
      if (e.pointerType === 'touch' && !painting) return;
      const r = frameEl.getBoundingClientRect();
      const x = Math.round(((e.clientX - r.left) / r.width) * 1000) / 10;
      const y = Math.round(((e.clientY - r.top) / r.height) * 1000) / 10;
      const now = performance.now();
      if (pts.length && pts[0].t === null) pts = pts.map((p, i) => ({ ...p, t: now - (pts.length - i) * 60 }));
      const last = pts[pts.length - 1];
      cur = { x, y, t: now };
      if (!last || Math.abs(last.x - x) + Math.abs(last.y - y) >= 1.2) pts = pts.concat([{ x, y, t: now }]).slice(-90);
      kick();
    });
    const cap = hero.querySelector<HTMLElement>('[data-caption-out]');
    hero.querySelectorAll<HTMLButtonElement>('[data-pick]').forEach((b) => {
      b.addEventListener('click', (e) => {
        e.stopPropagation();
        const k = b.dataset.pick;
        hero.querySelectorAll<HTMLElement>('.look').forEach((l) => {
          const on = l.dataset.look === k; l.hidden = !on;
          if (on) { hero.style.backgroundColor = l.dataset.bg || ''; if (cap) cap.textContent = l.dataset.caption || ''; }
        });
        hero.querySelectorAll('[data-pick]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        lookK = k || 'rock'; pts = startFor(lookK); cur = { ...pts[pts.length - 1] }; kick();
      });
    });
  }
</script>
