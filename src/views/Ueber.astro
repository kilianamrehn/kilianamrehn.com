---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Mail from '../components/Mail.astro';
import portraitSheets from '../data/portraits.json';
import works from '../data/arbeiten.json';
import imgmeta from '../data/imgmeta.json';
import { clients, routes, type Lang } from '../data/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const en = lang === 'en';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
// Halt es an: alle Bilder der Seite (Porträts, Arbeiten, Was bleibt), ohne Flashes
const RN: Record<string, [string, string]> = { moldau: ['Moldau 2022', 'Moldova 2022'], myanmar: ['Myanmar 2017', 'Myanmar 2017'], thailand: ['Thailand 2017', 'Thailand 2017'], malaysia: ['Malaysia 2017', 'Malaysia 2017'], hambi: ['Hambacher Forst 2018', 'Hambach Forest 2018'], gatzweiler: ['Garzweiler 2019', 'Garzweiler 2019'], blm: ['Black Lives Matter Köln', 'Black Lives Matter Cologne'], kairo: ['Ägypten 2023', 'Egypt 2023'] };
const fl: [string, string][] = [];
const seenFl = new Set<string>();
const addFl = (n: string, name: string) => { if (!seenFl.has(n)) { seenFl.add(n); fl.push([n, name]); } };
for (const sh of portraitSheets as any[]) for (const i of sh.d.imgs) addFl(i.slug, i.named ? i.nm : (en ? 'Portrait' : 'Porträt'));
for (const p of works as any[]) for (const sec of p.sections) for (const it of sec.items) if (typeof it === 'string' && it.startsWith('w-')) addFl(it, p.title);
for (const n of Object.keys(imgmeta)) if (n.startsWith('r-')) { const r = RN[n.split('-')[1]]; if (r) addFl(n, r[en ? 1 : 0]); }

const T = {
  de: {
    title: 'Über Kilian Amrehn · Fotograf & App-Entwickler in Köln',
    description: 'Kilian Amrehn, Fotograf und App-Entwickler aus Köln. Porträts für Artists mit gerichtetem Licht, Kampagnen, Reportage. Making-of und Kontakt.',
    h1: 'Über · Fotograf und App-Entwickler in Köln',
    claim: 'Ich baue Licht <span>und warte, bis jemand hineinschaut.</span>',
    video: 'Making-of eines Shootings',
    videoCap: 'Making-of, 2025',
    meAlt: 'Kilian Amrehn, Fotograf in Köln, auf einem rosa Stuhl',
    bio: [
      'Ich bin Kilian. Ich fotografiere Menschen, die auf Bühnen stehen oder vor Kameras: Musik, Schauspiel, Kunst, Moderation. Mit gerichtetem Licht, manchmal farbig, manchmal ganz hell.',
      'Viele Jahre stand ich selbst vor der Kamera. Ich weiß, wie es sich anfühlt, fotografiert zu werden, und wie viel davon abhängt, ob man sich im Raum sicher fühlt.',
      'Mich interessiert der Moment kurz nach der Pose, wenn jemand vergisst, gesehen zu werden.',
      'Mein Licht kommt aus der Mode und der Werbung. Es kann glänzen oder flüstern, mit zwei Leuten am Set oder mit zwanzig.',
    ],
    apps: 'Daneben entwickle ich Apps. Mit Verge habe ich ein Kartenspiel gebaut, mit dem sich Menschen näher kennenlernen. Das Besondere: Jede Person in der Runde stellt ein, wie weit sie mit jeder anderen gehen möchte. Das gibt es in dieser Form noch nicht. Und manchmal arbeite ich ohne eigenes Licht:',
    appsLink: 'als Reportage',
    kicker: 'Zwölf Bilder pro Sekunde',
    line: 'Halt es an.',
    stop: 'Stopp',
    stopped: 'Angehalten bei',
    resume: 'Weiter',
    clients: 'Gearbeitet mit',
    contact: 'Kontakt',
    contactId: 'kontakt',
    where: 'Köln, und wo immer das Licht gebraucht wird.',
  },
  en: {
    title: 'About Kilian · Photographer & App Developer in Cologne',
    description: 'Kilian Amrehn, photographer and app developer from Cologne. Artist portraits with directed light, campaigns, reportage. Behind the scenes and contact.',
    h1: 'About · Photographer and app developer in Cologne',
    claim: 'I build light <span>and wait for someone to look into it.</span>',
    video: 'Behind the scenes of a shoot',
    videoCap: 'Behind the scenes, 2025',
    meAlt: 'Kilian Amrehn, photographer in Cologne, on a pink chair',
    bio: [
      'I’m Kilian. I photograph people who stand on stages or in front of cameras: music, acting, art, presenting. With directed light, sometimes coloured, sometimes bright.',
      'For many years I stood in front of the camera myself. I know what it feels like to be photographed, and how much depends on whether you feel safe in the room.',
      'I am drawn to the moment just after the pose, when someone forgets they are being seen.',
      'My light comes from fashion and advertising. It can shine or whisper, with two people on set or with twenty.',
    ],
    apps: 'I also build apps. Verge is a card game that helps people get to know each other. Everyone in the group decides how far they want to go with each other person. Nothing like it exists in this form yet. And sometimes I work without any light of my own, in',
    appsLink: 'reportage',
    kicker: 'Twelve frames per second',
    line: 'Freeze it.',
    stop: 'Stop',
    stopped: 'Stopped at',
    resume: 'Resume',
    clients: 'Worked with',
    contact: 'Contact',
    contactId: 'contact',
    where: 'Cologne, and wherever the light is needed.',
  },
};
const t = T[lang];
---
<Base lang={lang} image="/media/og/ueber.jpg" alternate={routes.about[en ? 'de' : 'en']} title={t.title} description={t.description}>
<section class="wrap top">
  <h1 class="mono mute">{t.h1}</h1>
  <p class="display claim" set:html={t.claim} />
</section>
<section class="wrap trio">
  <figure>
    <video src={base + 'media/making-of.mp4'} poster={base + 'media/making-of-poster.jpg'} autoplay muted loop playsinline preload="metadata" aria-label={t.video}></video>
    <figcaption class="mono mute">{t.videoCap}</figcaption>
  </figure>
  <figure>
    <Img src="kilian-amrehn-fotograf-koeln" alt={t.meAlt} sizes="(max-width: 900px) 100vw, 33vw" class="me" />
    <figcaption class="mono mute">Kilian Amrehn</figcaption>
  </figure>
  <div class="bio">
    {t.bio.map((p) => <p>{p}</p>)}
    <p>{t.apps} <a class="u" href={base + routes.reportage[lang]}>{t.appsLink}</a>.</p>
  </div>
</section>

<section class="flick" data-flick data-kicker-text={t.kicker} data-line-text={t.line} data-stop-text={t.stop} data-stopped-text={t.stopped} data-resume-text={t.resume}>
  <div class="frames" data-list={JSON.stringify(fl)} data-base={base + 'img/'}>
    <img class="fr" src={`${base}img/${fl[0][0]}-640.webp`} alt="" decoding="async" />
  </div>
  <div class="shade"></div>
  <div class="wrap fl-ui">
    <div><span class="mono" data-kicker>{t.kicker}</span><span class="display fl-line" data-line aria-live="polite">{t.line}</span></div>
    <button type="button" class="stop display" data-toggle>{t.stop}</button>
  </div>
</section>

<section class="wrap clients">
  <h2 class="mono mute">{t.clients}</h2>
  <p class="runon cl">{clients.map(([n, hi], i) => <>{i > 0 && ' · '}{hi ? <b>{n}</b> : n}</>)}</p>
</section>
<section id={t.contactId} class="wrap kontakt">
  <h2 class="mono mute">{t.contact}</h2>
  <Mail lang={lang} />
  <p class="mute">{t.where}</p>
</section>
</Base>
<style>
  .top { padding-top: 40px; padding-bottom: 80px; }
  .top h1 { font-weight: 400; margin-bottom: 32px; }
  .claim { overflow-wrap: anywhere; font-size: clamp(44px, 8.3vw, 120px); line-height: .92; color: var(--white); }
  .claim :global(span) { color: var(--mute); }
  .trio { display: grid; grid-template-columns: 380px 380px 1fr; gap: 24px; align-items: start; padding-bottom: 140px; }
  figure { display: flex; flex-direction: column; gap: 12px; }
  video { width: 100%; aspect-ratio: 9 / 16; object-fit: cover; background: #111; }
  .trio :global(picture) { display: block; }
  .trio :global(.me) { width: 100%; height: auto; display: block; }
  .bio { display: flex; flex-direction: column; gap: 18px; font-size: 18px; line-height: 1.65; color: var(--mute2); padding-top: 8px; }
  .u { color: var(--white); text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 1000px) { .trio { grid-template-columns: 1fr 1fr; } .bio { grid-column: 1 / -1; } }
  @media (max-width: 600px) { .trio { grid-template-columns: 1fr; } }

  .flick { position: relative; height: min(760px, 90svh); overflow: hidden; }
  .frames { position: absolute; inset: 0; }
  .fr { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 35%; }
  /* Angehalten: ganzes Bild in seinem Format */
  .flick.stopped .fr { object-fit: contain; object-position: center; top: 3%; height: 94%; }
  .shade { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(180deg, rgba(34,16,15,.15) 0%, rgba(34,16,15,0) 40%, rgba(34,16,15,.85) 100%); }
  .fl-ui { position: absolute; left: 0; right: 0; bottom: 48px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px; }
  .fl-ui > div { display: flex; flex-direction: column; gap: 12px; color: var(--mute2); }
  .fl-line { font-size: clamp(48px, 7.2vw, 104px); color: var(--white); }
  .stop { width: clamp(110px, 10vw, 150px); aspect-ratio: 1; border-radius: 999px; border: 0; background: var(--white); color: var(--ink); font-size: 22px; letter-spacing: -.02em; cursor: pointer; }
  .clients { padding-top: 140px; padding-bottom: 100px; }
  .cl { color: var(--mute); }
  .clients h2, .kontakt h2 { font-weight: 400; margin-bottom: 24px; }
  .kontakt { padding-bottom: 140px; display: flex; flex-direction: column; gap: 12px; scroll-margin-top: 40px; }
  .kontakt :global(.mail) { font-size: clamp(36px, 6.6vw, 96px); }
</style>
<script>
  // 12 Bilder pro Sekunde aus allen Bildern der Seite, zufällig gemischt; vorgeladen, damit nichts ruckelt
  const box = document.querySelector<HTMLElement>('[data-flick]');
  const btn = box?.querySelector<HTMLButtonElement>('[data-toggle]');
  const wrap = box?.querySelector<HTMLElement>('.frames');
  const img = box?.querySelector<HTMLImageElement>('.fr');
  if (box && btn && wrap && img) {
    const list: [string, string][] = JSON.parse(wrap.dataset.list || '[]');
    const B = wrap.dataset.base || '';
    for (let i = list.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [list[i], list[j]] = [list[j], list[i]]; }
    const url = (n: string, w: number) => `${B}${n}-${w}.webp`;
    const ready = new Map<number, boolean>();
    const pre = (k: number) => { const i = ((k % list.length) + list.length) % list.length; if (ready.has(i)) return; ready.set(i, false); const im = new Image(); im.onload = () => ready.set(i, true); im.onerror = () => ready.set(i, true); im.src = url(list[i][0], 640); };
    let pos = 0, stopped = false, visible = false, last = 0;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    for (let k = 0; k < 16; k++) pre(k);
    const tick = (t: number) => {
      if (!stopped && visible && !reduce && t - last >= 83) {
        const nx = (pos + 1) % list.length;
        if (ready.get(nx)) { pos = nx; img.src = url(list[pos][0], 640); last = t; for (let k = 1; k <= 16; k++) pre(pos + k); }
      }
      requestAnimationFrame(tick);
    };
    new IntersectionObserver((es) => { visible = es[0].isIntersecting; }).observe(box);
    requestAnimationFrame(tick);
    const kicker = box.querySelector('[data-kicker]')!; const line = box.querySelector('[data-line]')!;
    const tx = box.dataset;
    btn.addEventListener('click', () => {
      if (stopped) {
        stopped = false; box.classList.remove('stopped'); img.src = url(list[pos][0], 640);
        kicker.textContent = tx.kickerText || ''; line.textContent = tx.lineText || ''; btn.textContent = tx.stopText || '';
      } else {
        stopped = true; box.classList.add('stopped'); img.src = url(list[pos][0], 1200);
        kicker.textContent = tx.stoppedText || ''; line.textContent = list[pos][1]; btn.textContent = tx.resumeText || '';
      }
    });
  }
</script>
