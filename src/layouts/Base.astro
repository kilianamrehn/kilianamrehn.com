---
import '@fontsource-variable/host-grotesk';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import { site, nav } from '../data/site';
import Mail from '../components/Mail.astro';

interface Props { title: string; description: string; image?: string; lang?: 'de' | 'en'; headerOverlay?: boolean; bodyClass?: string; schema?: object[]; alt?: string }
const { title, description, image, lang = 'de', headerOverlay = false, bodyClass = '', schema = [], alt } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const u = (p: string) => base + p.replace(/^\//, '');
const canonical = new URL(Astro.url.pathname, site.url).href.replace(/^(https:\/\/[^/]+)\/kilianamrehn\.com/, '$1');
const path = Astro.url.pathname.replace(base, '/');
const ogImage = image ? new URL(image, Astro.site).href : undefined;

const business = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'ProfessionalService'],
  '@id': site.url + '/#business',
  name: 'Kilian Amrehn Fotografie',
  description: 'Künstlerporträts, Musikerfotos, Schauspielporträts und Kampagnen aus Köln.',
  url: site.url,
  email: `${site.mailUser}@${site.mailDomain}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Köln', addressRegion: 'NRW', addressCountry: 'DE' },
  areaServed: ['Köln', 'Düsseldorf', 'Berlin', 'Deutschland', 'Europa'],
  founder: { '@id': site.url + '/#person' },
  sameAs: [site.instagram].filter(Boolean),
};
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': site.url + '/#person',
  name: site.name,
  jobTitle: ['Fotograf', 'App-Entwickler'],
  knowsAbout: ['Künstlerporträts', 'Musikfotografie', 'Schauspielporträts', 'Kampagnenfotografie', 'Reportage', 'App-Entwicklung'],
  address: { '@type': 'PostalAddress', addressLocality: 'Köln', addressCountry: 'DE' },
  url: site.url,
  sameAs: [site.instagram, site.linkedin].filter(Boolean),
};
const ld = [business, person, ...schema];
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<link rel="alternate" hreflang="de" href={site.url + '/'}>
<link rel="alternate" hreflang="en" href={site.url + '/en/'}>
<meta property="og:type" content="website">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_US'}>
{ogImage && <meta property="og:image" content={ogImage}>}
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#070605">
<link rel="icon" href={u('favicon.svg')} type="image/svg+xml">
<link rel="sitemap" href={u('sitemap-index.xml')}>
{ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
</head>
<body class={bodyClass}>
<a class="visually-hidden" href="#inhalt">Zum Inhalt</a>
<header class:list={['site-header wrap', { overlay: headerOverlay }]}>
  <a class="brand" href={u('')}>Kilian Amrehn</a>
  <nav aria-label="Hauptnavigation">
    {nav.map((n) => <a href={u(n.href)} aria-current={path.startsWith('/' + n.href) ? 'page' : undefined}>{n.label}</a>)}
    <span class="lang"><a href={u('')} aria-current={lang === 'de' ? 'true' : undefined}>DE</a> / <a href={u('en/')} aria-current={lang === 'en' ? 'true' : undefined} hreflang="en">EN</a></span>
  </nav>
</header>
<main id="inhalt"><slot /></main>
<footer class="site-footer">
  <div class="wrap">
    <div style="display:flex;flex-direction:column;gap:14px">
      <span class="mono mute">{lang === 'de' ? 'Kein Formular. Einfach schreiben.' : 'No forms. Just write.'}</span>
      <Mail />
    </div>
    <div class="footer-links">
      <a href={site.instagram} rel="me noopener" target="_blank">Instagram</a>
      {site.linkedin && <a href={site.linkedin} rel="me noopener" target="_blank">LinkedIn</a>}
      <a href={u('portraitfotografie/')}>Portraitfotografie Köln</a>
      <a href={u('impressum/')}>Impressum</a>
      <a href={u('datenschutz/')}>Datenschutz</a>
    </div>
  </div>
</footer>
</body>
</html>
<style>
  .overlay { position: absolute; top: 0; left: 0; right: 0; max-width: none; }
  @media (min-width: 1536px) { .overlay { padding-left: calc((100vw - var(--max)) / 2 + var(--pad)); padding-right: calc((100vw - var(--max)) / 2 + var(--pad)); } }
</style>
