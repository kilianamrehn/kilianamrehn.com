---
// Bild aus src/assets/img per Dateiname (ohne .jpg). Erzeugt AVIF/WebP in mehreren Größen.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
const all = import.meta.glob<{ default: ImageMetadata }>('/src/assets/img/*.jpg', { eager: true });
interface Props { src: string; alt: string; sizes?: string; pos?: string; class?: string; style?: string; loading?: 'lazy' | 'eager'; fetchpriority?: 'high' | 'low' | 'auto'; widths?: number[]; quality?: number }
const { src, alt, sizes = '100vw', pos, class: cls, style = '', loading = 'lazy', fetchpriority, widths, quality } = Astro.props;
const mod = all[`/src/assets/img/${src}.jpg`];
if (!mod) throw new Error(`Bild nicht gefunden: ${src}`);
const w = (widths ?? [480, 800, 1200, 1600]).filter((x) => x <= mod.default.width).concat(widths ? [] : [mod.default.width]);
const st = `${pos ? `object-position:${pos};` : ''}${style}`;
---
<Picture src={mod.default} alt={alt} formats={['avif', 'webp']} widths={[...new Set(w)]} sizes={sizes} loading={loading} fetchpriority={fetchpriority} class={cls} style={st || undefined} decoding="async" quality={quality} />
