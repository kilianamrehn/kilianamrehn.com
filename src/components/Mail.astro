---
import { site } from '../data/site';
interface Props { class?: string }
const { class: cls = 'mail' } = Astro.props;
---
<button type="button" class={cls} data-mail={`${site.mailUser}|${site.mailDomain}`.split('').reverse().join('')} aria-label="E-Mail schreiben">{site.mailUser}<span>[at]</span>{site.mailDomain.replace('.com', '')}<span>.</span>com</button>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-mail]').forEach((b) => {
    b.addEventListener('click', () => {
      const [u, d] = (b.dataset.mail || '').split('').reverse().join('').split('|');
      window.location.href = 'mailto:' + u + '@' + d;
    });
  });
</script>
