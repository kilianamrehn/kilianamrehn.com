---
import Leistung from '../views/Leistung.astro';
import { FAQ_PRICE, FAQ_TIME, FAQ_SPEED, FAQ_USE, FAQ_STUDIO, FAQ_HMU, FAQ_WEAR, FAQ_UNFOTOGEN } from '../data/leistung';
---
<Leistung
  alternate="en/presenter-photography-cologne/"
  og="/media/og/moderation.jpg"
  title="Moderationsfotografie Köln · Pressefotos · Kilian Amrehn"
  description="Moderationsfotografie in Köln: Pressefotos und Porträts für TV- und Radiomoderation, Hosts, Speaker, Podcasts und Creator. Für Sender, Agentur, Bühne und Social Media."
  h1="Moderationsfotografie Köln"
  lead="Pressefotos und Porträts für alle, die moderieren, sprechen und senden."
  img={{ src: 'p-bianca-berding-moderatorin-1', alt: 'Bianca Berding, Moderatorin, Pressefoto im Studio, Moderationsfotografie Köln' }}
  text={[
    'Wer moderiert, ist das Gesicht einer Sendung, eines Events oder einer Marke. Das Bild dazu landet bei Sendern, Agenturen, Veranstaltern, in Programmheften und auf Social Media. Ich fotografiere Moderator:innen, Hosts, Speaker und Creator in Köln.',
    'Wir machen eine klare Serie für Presse und Agentur, hell und offen, so wie man dich auf Sendung kennt. Und dazu Bilder mit mehr Haltung, für Bühne, Website oder Podcast-Cover. So hast du für jede Anfrage das passende Foto.',
    'Ich stand selbst lange vor der Kamera und weiß, wie anders es ist, fotografiert zu werden, als zu moderieren. Deshalb nehmen wir uns Zeit, bis die Bilder nach dir aussehen und nicht nach Pressefoto.',
    'Im Studio, draußen in Köln oder an deinem Set. Vorher sprechen wir über Formate, Sender und was die Bilder können sollen.',
  ]}
  links={[['Bianca Berding', 'kuenstlerportraits/#bianca-berding'], ['Schauspielfotografie Köln', 'schauspielfotografie-koeln/'], ['Portraitfotografie Köln', 'portraitfotografie/'], ['Alle Porträts', 'kuenstlerportraits/']]}
  service="Moderationsfotografie" offers={['Pressefotos für Moderation', 'Porträts für Speaker', 'Podcast-Cover', 'Porträts für Creator']}
  examples={[{ src: 'p-bianca-berding-moderatorin-2', label: 'Bianca Berding', href: 'kuenstlerportraits/#bianca-berding' }, { src: 'p-bianca-berding-moderatorin-3', label: 'Bianca Berding', href: 'kuenstlerportraits/#bianca-berding' }, { src: 'p-portraet-koeln-4', label: 'Alle Porträts', href: 'kuenstlerportraits/' }]}
  faq={[['Was unterscheidet deine Bilder von einem Business-Headshot?', 'Ich habe gelernt, wie in Mode, Kampagnen und Werbung Licht gesetzt wird. Deshalb geht bei mir von Hochglanz bis künstlerisch sehr viel. Gerade im Personal Branding ist es spannend, nicht wie das hundertste Business-Porträt im Anzug auszusehen.'], ['Fotografierst du auch im Büro oder auf der Bühne?', 'Ja. Ich fotografiere Menschen überall, auch an deinem Arbeitsplatz oder bei einem Vortrag.'], FAQ_PRICE, FAQ_TIME, FAQ_USE, FAQ_STUDIO, FAQ_HMU, FAQ_UNFOTOGEN]}
/>
