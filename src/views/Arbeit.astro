---
// Eine Arbeit (Kampagne oder freie Strecke): Titel, ggf. Film oben, Bögen mit Bildern, Abspann, Vor/Zurück.
import { altOf as altText } from '../data/alts';
import Base from '../layouts/Base.astro';
import Tisch from '../components/Tisch.astro';
import Lightbox from '../components/Lightbox.astro';
import { routes, campaignPath, type Lang } from '../data/site';
import vm from '../data/vidmeta.json';
interface Props { lang: Lang; p: any; prev: any; next: any; data: any }
const { lang, p, prev, next, data } = Astro.props;
const en = lang === 'en';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const roleEn: Record<string, string> = { Produktion: 'Production', Regie: 'Director', Fotoassistenz: 'Photo assistance', Foto: 'Photography', 'Veröffentlicht': 'Published in', Agentur: 'Agency', Auftrag: 'Client', Tiertrainerin: 'Animal trainer', Kollektiv: 'Collective', 'Art Direction, Foto': 'Art direction, photography', 'Video-Assistenz': 'Video assistance', Assistenz: 'Assistance', Stills: 'Stills', Produktionsassistenz: 'Production assistance', 'Co-Produktion': 'Co-production', Ort: 'Location', 'Creative Direction Video': 'Creative direction, video', 'Creative Direction Stills': 'Creative direction, stills' };
const kind = en ? p.kindEn : p.kind;
const meta = [kind, p.client].filter(Boolean).join(' · ');
const text = en ? p.textEn : p.textDe;
const T = en
  ? { suffix: 'Kilian Amrehn', by: 'photographed by Kilian Amrehn', credits: 'Credits', prev: '← Previous', all: 'All work', next: 'Next →', more: 'More work', film: 'Film' }
  : { suffix: 'Kilian Amrehn', by: 'fotografiert von Kilian Amrehn', credits: 'Abspann', prev: '← Vorherige', all: 'Alle Arbeiten', next: 'Nächste →', more: 'Weitere Arbeiten', film: 'Film' };
const isKi = (n: string) => n.includes('-ki-');
const alt = (n: string, i: number) => isKi(n)
  ? `${p.title}, ${en ? 'AI-animated video from the photos' : 'KI-animiertes Video aus den Fotos'}`
  : n === 'silent-escape-bts' ? `${p.title}, Behind the Scenes` : altText(n, en, `${p.title}, ${kind}, ${T.by}, ${en ? 'image' : 'Bild'} ${i + 1}`);
const kindT = kind.split(' · ').filter((x: string) => x !== p.title).join(' · ');
const desc = ((en ? (p.textEn || '') : (p.textDe || '')).split('. ')[0].replace(/\.$/, '') + (text ? '. ' : '') + (en
  ? `${p.title}, ${kindT}${p.client && p.client !== p.title ? ' for ' + p.client : ''}. Photographed by Kilian Amrehn, Cologne.`
  : `${p.title}, ${kindT}${p.client && p.client !== p.title ? ' für ' + p.client : ''}. Fotografiert von Kilian Amrehn, Köln.`)).slice(0, 300);
const top = p.top ? (vm as any)[p.top] : null;
const lightOf = (hex: string) => { const n = parseInt(hex.slice(1), 16); return (0.299 * Math.floor(n / 65536) + 0.587 * (Math.floor(n / 256) % 256) + 0.114 * (n % 256)) / 255 > 0.6; };
const inkVars = (hex: string) => lightOf(hex) ? ';--tx:#16110e;--tx2:rgba(22,17,14,.72);--tx3:rgba(22,17,14,.5)' : '';
---
<Base lang={lang} image={`/media/og/${p.slug}.jpg`} alternate={campaignPath(p.slug, en ? 'de' : 'en')} title={`${p.title} · ${kindT} · ${T.suffix}`} description={desc}>
<section class="a-head" style={`background:${p.color}${inkVars(p.color)}`}>
  <div class="wrap a-in">
    <span class="mono kick">{meta}</span>
    <h1 class="display a-title">{p.title}</h1>
    {text && <p class="a-text">{text}</p>}
  </div>
  {top && (
    <div class="wrap film">
      <video data-autoplay src={`${base}media/video/${p.top}.mp4`} poster={`${base}img/v-${p.top}.webp`} muted loop playsinline controls preload="metadata" width={top[0]} height={top[1]} aria-label={`${p.title}, ${T.film}`}></video>
    </div>
  )}
</section>
<Tisch sheets={data.sheets} lang={lang} alt={alt} caption={p.title} first />
<Lightbox lang={lang} />
{p.credits.length > 0 && (
<section class="abspann" style={`background:${p.color}${inkVars(p.color)}`}>
  <div class="ab-in">
    <div class="mono ab-title">{T.credits}</div>
    <div class="screen" data-screen>
      <div class="roll" data-roll tabindex="0" aria-label={T.credits}>
        <div class="reel" data-reel>
          <div class="ch">
            {p.credits.map(([r, n]: [string, string]) => <div class="row"><span class="mono">{en ? roleEn[r] ?? r : r}</span><span class="display">{n}</span></div>)}
          </div>
          {(p.chapters ?? []).map((c: any) => (
            <div class="ch">
              <div class="mono ch-t">{en ? c.tEn : c.t}</div>
              {c.rows.map(([r, n]: [string, string]) => <div class="row"><span class="mono">{en ? roleEn[r] ?? r : r}</span><span class="display">{n}</span></div>)}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
)}
<nav class="pn" aria-label={T.more}>
  <a href={base + campaignPath(prev.slug, lang)} style={`background:${prev.color}${inkVars(prev.color)}`}><span class="mono">{T.prev}</span><span class="display">{prev.title}</span></a>
  <a class="all mono" href={base + routes.campaigns[lang]}>{T.all}</a>
  <a href={base + campaignPath(next.slug, lang)} style={`background:${next.color};text-align:right;align-items:flex-end${inkVars(next.color)}`}><span class="mono">{T.next}</span><span class="display">{next.title}</span></a>
</nav>
</Base>
<style>
  .a-head { position: relative; padding: clamp(56px, 8vw, 110px) 0 clamp(40px, 5vw, 70px); }
  .a-in { display: flex; flex-direction: column; gap: 22px; }
  .kick { color: var(--tx2, rgba(240,228,218,.75)); letter-spacing: .16em; text-transform: uppercase; font-size: 12px; }
  .a-title { font-size: clamp(52px, 9vw, 140px); line-height: .88; color: var(--tx, var(--white)); margin: 0; text-wrap: balance; }
  .a-text { max-width: 60ch; margin: 0; color: var(--tx, rgba(240,228,218,.9)); font-size: clamp(16px, 1.4vw, 19px); line-height: 1.6; }
  .film { margin-top: clamp(32px, 5vw, 64px); }
  .film video { width: 100%; height: auto; display: block; box-shadow: 0 30px 80px rgba(0,0,0,.45); }
  .abspann { color: var(--tx, var(--white)); }
  .ab-in { max-width: 1240px; margin: 0 auto; padding: clamp(56px, 8vw, 110px) var(--pad); display: flex; flex-direction: column; gap: 22px; }
  .ab-title { text-align: center; letter-spacing: .3em; text-transform: uppercase; color: var(--tx2, rgba(240,228,218,.75)); }
  /* Kinoleinwand 21:9. Passt der Abspann nicht hinein, rollt er wie im Film; man kann selbst scrollen. */
  .screen { position: relative; aspect-ratio: 21 / 9; background: #0b0908; color: #f4ece4; box-shadow: 0 30px 80px rgba(0,0,0,.45), inset 0 0 0 1px rgba(255,255,255,.04); overflow: hidden; }
  .roll { position: absolute; inset: 0; overflow-y: auto; scrollbar-width: none; overscroll-behavior: contain; outline: none;
    -webkit-mask-image: linear-gradient(transparent, #000 14%, #000 86%, transparent); mask-image: linear-gradient(transparent, #000 14%, #000 86%, transparent); }
  .roll::-webkit-scrollbar { display: none; }
  .reel { display: flex; flex-direction: column; gap: clamp(26px, 3.4vw, 48px); min-height: 100%; justify-content: center; padding: clamp(18px, 3vw, 40px) clamp(16px, 4vw, 56px); box-sizing: border-box; }
  .screen.rolling .reel { justify-content: flex-start; padding-top: var(--sh); padding-bottom: var(--sh); }
  .ch { display: flex; flex-direction: column; gap: clamp(8px, 1vw, 14px); }
  .ch-t { text-align: center; letter-spacing: .24em; text-transform: uppercase; font-size: clamp(10px, 1vw, 12px); color: rgba(244,236,228,.55); padding-bottom: 4px; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(14px, 2.4vw, 32px); align-items: baseline; }
  .row .mono { text-align: right; color: rgba(244,236,228,.6); font-size: clamp(9px, 1vw, 12px); letter-spacing: .14em; text-transform: uppercase; }
  .row .display { font-size: clamp(14px, 1.9vw, 28px); line-height: 1.2; }
  .pn { display: flex; flex-wrap: wrap; }
  .pn a { flex: 1 1 320px; display: flex; flex-direction: column; gap: 10px; padding: 48px var(--pad); color: var(--tx, var(--white)); }
  .pn .display { font-size: clamp(32px, 4vw, 56px); line-height: 1; }
  .pn .all { flex: 0 1 240px; align-items: center; justify-content: center; background: #111; }
</style>
<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-screen]').forEach((scr) => {
    const roll = scr.querySelector<HTMLElement>('[data-roll]')!;
    const reel = scr.querySelector<HTMLElement>('[data-reel]')!;
    let on = false, vis = false, hold = 0, pos = 0, last = 0, raf = 0;
    const fit = () => {
      scr.classList.remove('rolling'); scr.style.removeProperty('--sh');
      on = reel.scrollHeight > roll.clientHeight + 2;
      if (on) { scr.classList.add('rolling'); scr.style.setProperty('--sh', roll.clientHeight + 'px'); }
    };
    const speed = () => Math.max(18, roll.clientHeight / 9); // px pro Sekunde
    const tick = (t: number) => {
      raf = requestAnimationFrame(tick);
      const dt = last ? Math.min(0.1, (t - last) / 1000) : 0; last = t;
      if (!on || !vis || reduce || t < hold) { pos = roll.scrollTop; return; }
      pos += speed() * dt;
      if (pos >= roll.scrollHeight - roll.clientHeight - 1) { pos = 0; hold = t + 1200; }
      roll.scrollTop = pos;
    };
    const pause = () => { hold = performance.now() + 3500; };
    ['wheel', 'touchstart', 'pointerdown', 'keydown'].forEach((e) => roll.addEventListener(e, pause, { passive: true }));
    roll.addEventListener('scroll', () => { if (performance.now() < hold) pos = roll.scrollTop; }, { passive: true });
    new IntersectionObserver(([e]) => { vis = e.isIntersecting; }, { threshold: 0.4 }).observe(scr);
    new ResizeObserver(fit).observe(scr);
    fit(); raf = requestAnimationFrame(tick);
  });
</script>
