---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import { roleEn, type Kampagne } from '../data/kampagnen';
import { routes, campaignPath, type Lang } from '../data/site';
interface Props { lang: Lang; k: Kampagne; prev: Kampagne; next: Kampagne }
const { lang, k: raw, prev, next } = Astro.props;
const en = lang === 'en';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const T = {
  de: { suffix: 'Kilian Amrehn Fotografie', desc: 'Fotografie von Kilian Amrehn, Köln.', credits: 'Abspann', more: 'Weitere Kampagnen', prev: '← Vorherige', all: 'Alle Kampagnen', next: 'Nächste →' },
  en: { suffix: 'Kilian Amrehn Photography', desc: 'Photography by Kilian Amrehn, Cologne.', credits: 'Credits', more: 'More campaigns', prev: '← Previous', all: 'All campaigns', next: 'Next →' },
};
const t = T[lang];
const k = {
  ...raw,
  meta: en ? raw.metaEn : raw.meta,
  heroAlt: en ? raw.heroAltEn : raw.heroAlt,
  intro: en ? raw.introEn : raw.intro,
  pics: raw.pics.map((p) => ({ ...p, alt: en ? p.altEn : p.alt })),
  credits: raw.credits.map(([r, n]) => [en ? roleEn[r] ?? r : r, n]),
};
---
<Base lang={lang} alternate={campaignPath(k.slug, en ? 'de' : 'en')} title={`${k.title} · ${k.meta} · ${t.suffix}`} description={`${k.title}: ${k.meta}. ${t.desc}`} headerOverlay>
<section class="hero">
  <Img src={k.hero} alt={k.heroAlt} class="cover" loading="eager" fetchpriority="high" />
  <div class="shade"></div>
  <div class="wrap hero-t"><h1 class="display">{k.title}</h1><span class="mono" style={`color:${k.accent}`}>{k.meta}</span></div>
</section>
<section class="wrap intro"><p class="mute">{k.intro}</p></section>
{k.pics.length > 0 && <section class="wrap pics">{k.pics.map((p) => <Img src={p.src} alt={p.alt} class="pic" sizes="(max-width: 900px) 100vw, 50vw" />)}</section>}
<section class="abspann" style={`background:${k.color}`}>
  <div class="ab-in">
    <div class="mono ab-title" style={`color:${k.accent}`}>{t.credits}</div>
    {k.credits.map(([r, n]) => <div class="row"><span class="mono" style={`color:${k.accent}`}>{r}</span><span class="display">{n}</span></div>)}
  </div>
</section>
<nav class="pn" aria-label={t.more}>
  <a href={base + campaignPath(prev.slug, lang)} style={`background:${prev.color}`}><span class="mono">{t.prev}</span><span class="display">{prev.title}</span></a>
  <a class="all mono" href={base + routes.campaigns[lang]}>{t.all}</a>
  <a href={base + campaignPath(next.slug, lang)} style={`background:${next.color};text-align:right;align-items:flex-end`}><span class="mono">{t.next}</span><span class="display">{next.title}</span></a>
</nav>
</Base>
<style>
  .hero { position: relative; height: min(900px, 100svh); overflow: hidden; }
  .hero :global(picture) { position: absolute; inset: 0; }
  .shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(34,16,15,.5) 0%, rgba(34,16,15,0) 25%, rgba(34,16,15,0) 60%, rgba(34,16,15,.85) 100%); }
  .hero-t { position: absolute; left: 0; right: 0; bottom: 56px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px; }
  .hero-t h1 { font-size: clamp(56px, 9vw, 140px); line-height: .88; color: var(--white); }
  .intro { padding-top: 100px; padding-bottom: 100px; max-width: 900px; margin: 0; }
  .pics { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; padding-bottom: 120px; }
  .pics :global(.pic) { width: 100%; aspect-ratio: 2 / 3; object-fit: cover; }
  .ab-in { max-width: 1100px; margin: 0 auto; padding: 140px var(--pad); display: flex; flex-direction: column; gap: 32px; }
  .ab-title { text-align: center; letter-spacing: .3em; padding-bottom: 16px; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: baseline; }
  .row .mono { text-align: right; }
  .row .display { font-size: clamp(24px, 2.6vw, 36px); line-height: 1.1; color: var(--white); }
  .pn { display: flex; flex-wrap: wrap; }
  .pn a { flex: 1 1 320px; display: flex; flex-direction: column; gap: 10px; padding: 48px var(--pad); color: var(--white); }
  .pn .display { font-size: clamp(36px, 4vw, 56px); line-height: 1; }
  .pn .all { flex: 0 1 240px; align-items: center; justify-content: center; background: #111; }
  @media (max-width: 720px) { .pics { grid-template-columns: 1fr; } .row { grid-template-columns: 1fr; gap: 4px; } .row .mono { text-align: left; } }
</style>
