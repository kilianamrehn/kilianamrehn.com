---
// Arbeiten: Kampagnen und freie Strecken. Farbleiste oben, jede Arbeit auf einem Bogen in ihrer Farbe.
import Base from '../layouts/Base.astro';
import Tisch from '../components/Tisch.astro';
import Lightbox from '../components/Lightbox.astro';
import idx from '../data/tisch/arbeiten-index.json';
import { routes, campaignPath, type Lang } from '../data/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const en = lang === 'en';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const T = en
  ? { title: 'Campaign, Fashion & Editorial Photography Cologne · Work · Kilian Amrehn', desc: "Campaigns and personal series by Kilian Amrehn, Cologne: Scholl, Copenhagen Studios, P&C x Ellesse, PNTS, AppelrathCüpper, Bundesliga, New Icons' Club.", h1: 'Work', sub: 'Campaigns & personal series', view: 'View →' }
  : { title: 'Kampagnen-, Mode- und Editorial-Fotografie Köln · Arbeiten · Kilian Amrehn', desc: "Kampagnen und freie Strecken von Kilian Amrehn, Köln: Scholl, Copenhagen Studios, P&C x Ellesse, PNTS, AppelrathCüpper, Bundesliga, New Icons' Club.", h1: 'Arbeiten', sub: 'Kampagnen & freie Strecken', view: 'Ansehen →' };
const list = idx as any[];
const isLight = (hex: string) => { const n = parseInt(hex.slice(1), 16); return (0.299 * Math.floor(n / 65536) + 0.587 * (Math.floor(n / 256) % 256) + 0.114 * (n % 256)) / 255 > 0.6; };
const lightOf = (hex: string) => { const n = parseInt(hex.slice(1), 16); return (0.299 * Math.floor(n / 65536) + 0.587 * (Math.floor(n / 256) % 256) + 0.114 * (n % 256)) / 255 > 0.6; };
const inkVars = (hex: string) => lightOf(hex) ? ';--tx:#16110e;--tx2:rgba(22,17,14,.72);--tx3:rgba(22,17,14,.5)' : '';
---
<Base lang={lang} alternate={routes.campaigns[en ? 'de' : 'en']} title={T.title} description={T.desc}>
<section class="wrap ar-head">
  <h1 class="display big">{T.h1}</h1>
  <span class="mono sub">{T.sub}</span>
</section>
<nav class="bar mono" aria-label={T.h1}>
  {list.map((k) => <a href={`#${k.slug}`} style={`background:${k.band};color:${isLight(k.band) ? '#16110e' : 'var(--white)'}`}>{k.title}</a>)}
</nav>
{list.map((k) => (
  <article id={k.slug} class="ar">
    <a class="ar-top" href={base + campaignPath(k.slug, lang)} style={`background:${k.bg}${inkVars(k.bg)}`}>
      <span class="wrap ar-t">
        <span class="display ar-name">{k.title}</span>
        <span class="mono ar-meta">{en ? k.kindEn : k.kind} · {k.year}</span>
        <span class="mono ar-cta">{T.view}</span>
      </span>
    </a>
    <Tisch sheets={[{ bg: k.bg, d: k.d, m: k.m, href: base + campaignPath(k.slug, lang) }]} lang={lang} alt={(n, i) => `${k.title}, ${en ? k.kindEn : k.kind}, ${en ? 'photographed by' : 'fotografiert von'} Kilian Amrehn`} />
  </article>
))}
{!en && <p class="wrap mono ar-seo"><a href={base + 'kampagnenfotografie-koeln/'}>Kampagnenfotografie Köln →</a></p>}
<Lightbox lang={lang} />
</Base>
<style>
  .ar-head { padding-top: 32px; padding-bottom: 32px; display: flex; flex-wrap: wrap; align-items: baseline; gap: 12px 32px; }
  .big { font-size: clamp(72px, 11.7vw, 168px); line-height: .86; margin: 0; }
  .sub { color: var(--mute); letter-spacing: .16em; text-transform: uppercase; font-size: 12px; }
  /* alle Felder gleich breit, Reihen möglichst gleich voll (17 Arbeiten: 9 + 8 oder 6 + 6 + 5) */
  .bar { display: grid; grid-template-columns: repeat(9, minmax(0, 1fr)); position: sticky; top: 0; z-index: 60; }
  .bar > * { min-height: 52px; display: flex; align-items: center; padding: 0 16px; color: var(--white); font-size: 12px; }
  @media (max-width: 1600px) { .bar { grid-template-columns: repeat(6, minmax(0, 1fr)); } }
  @media (max-width: 720px) { .bar { display: flex; flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; } .bar > * { flex: 0 0 auto; } }
  .ar { scroll-margin-top: 52px; position: relative; }
  .ar-top { display: block; position: relative; z-index: 50; color: var(--tx, var(--white)); text-decoration: none; }
  .ar-t { display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px 28px; padding-top: 44px; padding-bottom: 8px; }
  .ar-name { font-size: clamp(40px, 6vw, 96px); line-height: .9; }
  .ar-meta { color: var(--tx2, rgba(240,228,218,.75)); letter-spacing: .14em; text-transform: uppercase; font-size: 12px; }
  .ar-cta { margin-left: auto; padding: 8px 14px; border: 1px solid var(--tx2, rgba(240,228,218,.6)); border-radius: 999px; font-size: 12px; }
  .ar :global(.sheet .band) { top: 0 !important; box-shadow: none !important; transform: none !important; }
  .ar :global(.ph) { cursor: pointer; }
  .ar-seo { padding-top: 48px; padding-bottom: 8px; font-size: 13px; letter-spacing: .12em; text-transform: uppercase; }
  .ar-seo a { color: var(--mute); }
</style>
