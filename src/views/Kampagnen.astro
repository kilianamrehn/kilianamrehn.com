---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import { kampagnen, weitere } from '../data/kampagnen';
import { routes, campaignPath, type Lang } from '../data/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const en = lang === 'en';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const T = {
  de: {
    title: 'Kampagnen & Editorial Fotografie Köln · Kilian Amrehn',
    description: "Kampagnen- und Editorial-Fotografie von Kilian Amrehn, Köln: Copenhagen Studios, Peek & Cloppenburg x Ellesse, Scholl, AppelrathCüpper, New Icons' Club.",
    h1: 'Kampagnen',
    view: 'Projekt ansehen →',
  },
  en: {
    title: 'Campaign & Editorial Photography Cologne · Kilian Amrehn',
    description: "Campaign and editorial photography by Kilian Amrehn, Cologne: Copenhagen Studios, Peek & Cloppenburg x Ellesse, Scholl, AppelrathCüpper, New Icons' Club.",
    h1: 'Campaigns',
    view: 'View project →',
  },
};
const t = T[lang];
const list = kampagnen.map((k) => ({ ...k, meta: en ? k.metaEn : k.meta, heroAlt: en ? k.heroAltEn : k.heroAlt }));
---
<Base lang={lang} alternate={routes.campaigns[en ? 'de' : 'en']} title={t.title} description={t.description}>
<section class="wrap"><h1 class="display big">{t.h1}</h1></section>
<nav class="bar mono" aria-label={t.h1}>
  {list.map((k) => <a href={`#${k.slug}`} style={`background:${k.color}`}>{k.title}</a>)}
  {weitere.map((w) => <span style={`background:${w.color}`}>{w.name}</span>)}
</nav>
{list.map((k, i) => (
  <section id={k.slug} class="k" style={`background:${k.color}`}>
    <div class:list={['wrap k-in', { rev: i % 2 === 1 }]}>
      <div class="k-text">
        <h2 class="display k-title" set:html={k.titleHtml} />
        <div class="tags"><span class="mono tag" style={`border-color:${k.accent}`}>{k.meta}</span><a class="mono cta" href={base + campaignPath(k.slug, lang)} style={`color:${k.color}`}>{t.view}</a></div>
      </div>
      <Img src={k.hero} alt={k.heroAlt} class="k-img" sizes="(max-width: 900px) 100vw, 45vw" />
    </div>
  </section>
))}
</Base>
<style>
  .big { font-size: clamp(72px, 11.7vw, 168px); line-height: .86; padding: 32px 0; }
  .bar { display: flex; flex-wrap: wrap; position: sticky; top: 0; z-index: 5; }
  .k { scroll-margin-top: 64px; }
  @media (max-width: 720px) { .bar { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; } .bar > * { flex: 0 0 auto; min-height: 52px; } .k { scroll-margin-top: 52px; } }
  .bar > * { flex: 1 1 160px; min-height: 64px; display: flex; align-items: center; padding: 0 20px; color: var(--white); }
  .k-in { display: flex; flex-wrap: wrap; gap: 48px; align-items: flex-end; padding-top: clamp(64px, 8vw, 120px); padding-bottom: clamp(64px, 8vw, 120px); }
  .k-in.rev { flex-direction: row-reverse; }
  .k-text { flex: 1 1 480px; display: flex; flex-direction: column; gap: 24px; }
  .k-title { font-size: clamp(56px, 9vw, 132px); line-height: .86; color: var(--white); }
  .tags { display: flex; flex-wrap: wrap; gap: 10px; }
  .tag { padding: 8px 14px; border: 1px solid; border-radius: 999px; }
  .cta { padding: 8px 14px; background: var(--white); border-radius: 999px; }
  .k :global(.k-img) { flex: 1 1 380px; width: 100%; max-width: 560px; aspect-ratio: 2 / 3; object-fit: cover; }
</style>
