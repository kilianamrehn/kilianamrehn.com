---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Mail from '../components/Mail.astro';
import { flicker } from '../data/flicker';
import { clients } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="Über Kilian Amrehn · Fotograf & App-Entwickler in Köln" description="Kilian Amrehn, Fotograf und App-Entwickler aus Köln. Künstlerporträts mit gerichtetem Licht, Kampagnen, Reportage. Making-of und Kontakt.">
<section class="wrap top">
  <h1 class="mono mute">Über · Fotograf und App-Entwickler in Köln</h1>
  <p class="display claim">Ich baue Licht <span>und warte, bis jemand hineinschaut.</span></p>
</section>
<section class="wrap trio">
  <figure>
    <video src={base + 'media/making-of.mp4'} poster={base + 'media/making-of-poster.jpg'} autoplay muted loop playsinline preload="metadata" aria-label="Making-of eines Shootings"></video>
    <figcaption class="mono mute">Making-of, 2025</figcaption>
  </figure>
  <figure>
    <Img src="kilian-amrehn-fotograf-koeln" alt="Kilian Amrehn, Fotograf in Köln" sizes="(max-width: 900px) 100vw, 33vw" class="me" />
    <figcaption class="mono mute">Kilian Amrehn</figcaption>
  </figure>
  <div class="bio">
    <p>Ich bin Kilian. Ich fotografiere Menschen, die auf Bühnen stehen oder vor Kameras: Musik, Schauspiel, Kunst. Mit gerichtetem, oft farbigem Licht und viel Dunkelheit drumherum.</p>
    <p>Viele Jahre stand ich selbst vor der Kamera. Ich weiß, wie es sich anfühlt, fotografiert zu werden, und wie viel davon abhängt, ob man sich im Raum sicher fühlt.</p>
    <p>Posen inszeniere ich nicht. Mich interessiert der Moment kurz danach, wenn jemand vergisst, dass er gesehen wird.</p>
    <p>Daneben entwickle ich Apps. Mit Verge habe ich das erste Gruppenspiel mit eingebautem Consent-System gebaut. Und manchmal arbeite ich ohne eigenes Licht: <a class="u" href={base + 'reportage/'}>als Reportage</a>.</p>
  </div>
</section>

<section class="flick" data-flick>
  <div class="frames">
    {flicker.map(([s, n], i) => <div class="frame" style={`animation-delay:-${(i * 0.085).toFixed(3)}s`} data-name={n}><Img src={s} alt="" sizes="100vw" widths={[800, 1400]} loading={i < 6 ? 'eager' : 'lazy'} /></div>)}
  </div>
  <div class="shade"></div>
  <div class="wrap fl-ui">
    <div><span class="mono" data-kicker>Acht Jahre, zwölf Bilder pro Sekunde</span><span class="display fl-line" data-line aria-live="polite">Halt es an.</span></div>
    <button type="button" class="stop display" data-toggle>Stopp</button>
  </div>
</section>

<section class="wrap clients">
  <h2 class="mono mute">Gearbeitet mit</h2>
  <p class="runon">{clients.map(([n, hi], i) => <>{i > 0 && ' · '}{hi ? <em>{n}</em> : n}</>)}</p>
</section>
<section id="kontakt" class="wrap kontakt">
  <h2 class="mono mute">Kontakt</h2>
  <Mail />
  <p class="mute">Köln, und wo immer das Licht gebraucht wird.</p>
</section>
</Base>
<style>
  .top { padding-top: 40px; padding-bottom: 80px; }
  .top h1 { font-weight: 400; margin-bottom: 32px; }
  .claim { overflow-wrap: anywhere; font-size: clamp(44px, 8.3vw, 120px); line-height: .92; color: var(--white); }
  .claim span { color: #6f665a; }
  .trio { display: grid; grid-template-columns: 380px 1fr 1fr; gap: 24px; align-items: start; padding-bottom: 140px; }
  figure { display: flex; flex-direction: column; gap: 12px; }
  video { width: 100%; aspect-ratio: 9 / 16; object-fit: cover; background: #111; }
  .trio :global(.me) { width: 100%; aspect-ratio: 2 / 3; object-fit: cover; }
  .bio { display: flex; flex-direction: column; gap: 18px; font-size: 18px; line-height: 1.65; color: #c9bfb0; padding-top: 8px; }
  .u { color: var(--white); text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 1000px) { .trio { grid-template-columns: 1fr 1fr; } .bio { grid-column: 1 / -1; } }
  @media (max-width: 600px) { .trio { grid-template-columns: 1fr; } }

  .flick { position: relative; height: min(760px, 90svh); overflow: hidden; }
  .frame { position: absolute; inset: 0; opacity: 0; animation: flk 2.04s step-end infinite; }
  .frame :global(picture), .frame :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 35%; }
  .flick.stopped .frame { animation: none; opacity: 0; }
  .flick.stopped .frame.on { opacity: 1; }
  @keyframes flk { 0% { opacity: 1; } 4.1667% { opacity: 0; } 100% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .frame:first-child { opacity: 1; } }
  .shade { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(180deg, rgba(7,6,5,.15) 0%, rgba(7,6,5,0) 40%, rgba(7,6,5,.85) 100%); }
  .fl-ui { position: absolute; left: 0; right: 0; bottom: 48px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px; }
  .fl-ui > div { display: flex; flex-direction: column; gap: 12px; color: #c9bfb0; }
  .fl-line { font-size: clamp(48px, 7.2vw, 104px); color: var(--white); }
  .stop { width: clamp(110px, 10vw, 150px); aspect-ratio: 1; border-radius: 999px; border: 0; background: var(--white); color: var(--ink); font-size: 22px; letter-spacing: -.02em; cursor: pointer; }
  .clients { padding-top: 140px; padding-bottom: 100px; }
  .clients h2, .kontakt h2 { font-weight: 400; margin-bottom: 24px; }
  .kontakt { padding-bottom: 140px; display: flex; flex-direction: column; gap: 12px; scroll-margin-top: 40px; }
  .kontakt :global(.mail) { font-size: clamp(36px, 6.6vw, 96px); }
</style>
<script>
  const box = document.querySelector<HTMLElement>('[data-flick]');
  const btn = box?.querySelector<HTMLButtonElement>('[data-toggle]');
  if (box && btn) {
    const frames = Array.from(box.querySelectorAll<HTMLElement>('.frame'));
    const kicker = box.querySelector('[data-kicker]')!; const line = box.querySelector('[data-line]')!;
    btn.addEventListener('click', () => {
      if (box.classList.contains('stopped')) {
        box.classList.remove('stopped'); frames.forEach((f) => f.classList.remove('on'));
        kicker.textContent = 'Acht Jahre, zwölf Bilder pro Sekunde'; line.textContent = 'Halt es an.'; btn.textContent = 'Stopp';
      } else {
        const f = frames[Math.floor(Math.random() * frames.length)];
        box.classList.add('stopped'); f.classList.add('on');
        kicker.textContent = 'Angehalten bei'; line.textContent = f.dataset.name || ''; btn.textContent = 'Weiter';
      }
    });
  }
</script>
