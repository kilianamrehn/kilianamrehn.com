---
import Leistung from '../views/Leistung.astro';
import { FAQ_PRICE, FAQ_TIME, FAQ_SPEED, FAQ_USE, FAQ_STUDIO, FAQ_HMU, FAQ_WEAR, FAQ_UNFOTOGEN } from '../data/leistung';
---
<Leistung
  alternate="en/actor-headshots-cologne/"
  og="/media/og/schauspiel.jpg"
  title="Schauspielfotografie Köln · Headshots · Kilian Amrehn"
  description="Schauspielfotografie in Köln: Headshots für Agenturen und Castings, Porträts fürs Showreel und freie Porträtreihen. Ruhig, nah, mit gerichtetem Licht."
  h1="Schauspielfotografie Köln"
  lead="Headshots und Porträts für Schauspiel, die zeigen, was du spielen kannst."
  img={{ src: 'p-slavko-popadic-3', alt: 'Slavko Popadić, Schauspieler, Headshot draußen in Köln, Schauspielfotografie Köln' }}
  text={[
    'Ein Headshot entscheidet oft, ob du eingeladen wirst. Er muss ehrlich sein, damit man dich beim Casting wiedererkennt, und trotzdem etwas erzählen. Ich fotografiere Schauspieler:innen in Köln für Agentur, Casting-Profile und Website.',
    'Wir machen eine ruhige, klare Serie, wie Agenturen sie brauchen, und dazu Bilder mit Licht und Haltung, die eine Rolle andeuten. So hast du beides: das Bild für die Datenbank und das Bild, an das man sich erinnert.',
    'Ich stand selbst lange vor der Kamera und weiß, wie schwer es ist, sich selbst zu spielen. Deshalb nehmen wir uns Zeit. Die besten Bilder entstehen meistens, wenn du aufhörst, ein Foto zu machen.',
    'Im Studio oder draußen in Köln. Vorher sprechen wir über deine Rollen, dein Casting-Profil und was die Bilder können sollen.',
  ]}
  links={[['Slavko Popadić', 'kuenstlerportraits/#slavko-popadic'], ['Pia Stutzenstein', 'kuenstlerportraits/#pia-stutzenstein'], ['David Vormweg', 'kuenstlerportraits/#david-vormweg'], ['Lea Mende', 'kuenstlerportraits/#lea-mende'], ['Alle Porträts', 'kuenstlerportraits/'], ['Moderationsfotografie Köln', 'moderationsfotografie-koeln/']]}
  service="Schauspielfotografie" offers={['Headshots für Agenturen', 'Casting-Fotos', 'Schauspielporträts']}
  examples={[{ src: 'p-pia-stutzenstein-schauspielerin-1', label: 'Pia Stutzenstein', href: 'kuenstlerportraits/#pia-stutzenstein' }, { src: 'p-david-vormweg-schauspieler-1', label: 'David Vormweg', href: 'kuenstlerportraits/#david-vormweg' }, { src: 'p-lea-mende-1', label: 'Lea Mende', href: 'kuenstlerportraits/#lea-mende' }, { src: 'p-slavko-popadic-4', label: 'Slavko Popadić', href: 'kuenstlerportraits/#slavko-popadic' }]}
  faq={[['Was braucht eine Agentur?', 'Vor allem klare, kaum bearbeitete Bilder, auf denen man genau sieht, wie du aussiehst. Darüber hinaus fühlen sich die Leute bei mir schnell wohl. Deshalb sehen sie auf den Bildern aus wie sie selbst, auch auf denen mit mehr Licht und Haltung.'],
    FAQ_PRICE, FAQ_TIME, FAQ_SPEED, FAQ_USE, FAQ_STUDIO, FAQ_HMU, FAQ_UNFOTOGEN]}
/>
