---
// Flashes: versteckte Seite, Zugang über die rote Lampe im Header.
// Alle Bilder und Videos liegen in Rahmen auf ochsenblutrotem Papier, bei jedem Öffnen neu gemischt.
// Desktop: greifen und verschieben. Handy: doppeltippen, halten, schieben, loslassen = wieder scrollen. Kein Großklicken.
import { altOf as altText } from '../data/alts';
import Base from '../layouts/Base.astro';
import { routes, type Lang } from '../data/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const en = lang === 'en';
import Pic from '../components/Pic.astro';
import im from '../data/imgmeta.json';
import vm from '../data/vidmeta.json';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
// Von Kilian aus Flashes genommen
const OUT = ['f-229'];
const imgs = Object.entries(im as Record<string, [number, number, number[]]>).filter(([n]) => n.startsWith('f-') && !OUT.includes(n)).map(([n, v]) => ({ n, w: v[0], h: v[1], v: false }));
const vids = Object.entries(vm as Record<string, number[]>).filter(([n]) => n.startsWith('flash-')).map(([n, v]) => ({ n, w: v[0], h: v[1], v: true }));
const all = [...imgs, ...vids];
---
<Base lang={lang} image="/media/og/flashes.jpg" alternate={routes.flashes[en ? 'de' : 'en']} title={en ? 'Flashes · Pictures from real life · Kilian Amrehn' : 'Flashes · Bilder aus dem echten Leben · Kilian Amrehn'} description={en ? 'Flashes: pictures from real life by Kilian Amrehn. Travels, friends, analogue film, phone pictures.' : 'Flashes: Bilder aus dem echten Leben von Kilian Amrehn. Reisen, Freunde, Analogfilme, Handyfotos.'} bodyClass="fl-body">
<section class="fl-top wrap"><h1 class="mono fl-h">Flashes</h1><span class="mono fl-hint"><span class="d">{en ? 'Sort them yourself' : 'Selber sortieren'}</span><span class="t">{en ? 'Double-tap, hold, drag' : 'Doppeltippen, halten, schieben'}</span></span></section>
<div class="fl-board" data-board data-city={en ? 'COLOGNE' : 'KÖLN'} style={`--paper:url(${base}media/marks/paper.png);--sprocket:url(${base}media/marks/sprocket.png)`}>
  {all.map((x) => (
    <div class="fl k-plain" data-w={x.w} data-h={x.h} hidden>
      <i class="sp t"></i><span class="e t"></span>
      {x.v
        ? <video data-src={`${base}media/video/${x.n}.mp4`} poster={`${base}img/v-${x.n}.webp`} muted loop playsinline preload="none" aria-hidden="true"></video>
        : <Pic name={x.n} alt={altText(x.n, en, en ? 'Flash, photo by Kilian Amrehn' : 'Flash, Foto von Kilian Amrehn', 'flash')} sizes="(max-width: 699px) 45vw, 460px" />}
      <span class="e b"></span><i class="sp b"></i>
    </div>
  ))}
</div>
</Base>
<script>
  const board = document.querySelector<HTMLElement>('[data-board]')!;
  const items = [...board.querySelectorAll<HTMLElement>('.fl')];
  const FR: Record<string, [number, number, number]> = { polaroid: [18, 18, 74], border: [12, 12, 12], negative: [16, 40, 40], torn: [16, 16, 16], plain: [0, 0, 0] };
  const KS = ['plain', 'plain', 'plain', 'plain', 'plain', 'plain', 'plain', 'border', 'border', 'border', 'border', 'polaroid', 'polaroid', 'polaroid', 'polaroid', 'negative', 'negative', 'negative', 'negative', 'torn', 'torn'];
  const R = Math.random, U = (a: number, b: number) => a + R() * (b - a), pick = <T,>(a: T[]) => a[Math.floor(R() * a.length)];
  const gauss = () => { let u = 0, v = 0; while (!u) u = R(); while (!v) v = R(); return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v); };
  const torn = () => { const p: string[] = []; for (let s = 0; s < 4; s++) for (let i = 0; i < 34; i++) { const t = (i / 34) * 100, j = R() * 1.1; const q = [[t, j], [100 - j, t], [100 - t, 100 - j], [j, 100 - t]][s]; p.push(`${q[0].toFixed(1)}% ${q[1].toFixed(1)}%`); } return `polygon(${p.join(',')})`; };
  let topZ = 1000;
  function layout() {
    const mob = innerWidth < 700, W = mob ? 390 : 1440, S = mob ? 0.52 : 1, fs = mob ? 0.6 : 1;
    const u = mob ? innerWidth / 390 : Math.min(1, innerWidth / 1440);
    const order = items.slice().sort(() => R() - 0.5);
    let y = 20, i = 0, z = 1, maxY = 0;
    const put = (el: HTMLElement, ls: number, x: number, yy: number) => {
      const w0 = +el.dataset.w!, h0 = +el.dataset.h!, sc = (ls * S) / Math.max(w0, h0);
      const w = Math.round(w0 * sc), ih = Math.round(h0 * sc);
      const kd = el.querySelector('video') ? pick(['plain', 'plain', 'border']) : pick(KS);
      const [px, pt, pb] = FR[kd].map((v) => Math.round(v * fs));
      const fw = w + 2 * px, fh = ih + pt + pb;
      const cx = Math.min(Math.max(x, fw / 2 - 6), W - fw / 2 + 6);
      el.className = 'fl k-' + kd; el.hidden = false;
      el.style.cssText = `left:${(cx - fw / 2) * u}px;top:${(yy - fh / 2) * u}px;width:${fw * u}px;height:${fh * u}px;--px:${px * u}px;--pt:${pt * u}px;--pb:${pb * u}px;--fs:${fs * u};z-index:${z++};transform:rotate(${kd === 'negative' ? 0 : U(-8, 8).toFixed(1)}deg);` + (kd === 'torn' ? `clip-path:${torn()};` : '');
      if (kd === 'negative') { const f = 2 + Math.floor(R() * 34); el.querySelector('.e.t')!.textContent = `${f}A  ▸  FLASHES`; el.querySelector('.e.b')!.textContent = `${f + 1}  ◂  ${board.dataset.city}`; }
      maxY = Math.max(maxY, yy + fh / 2);
    };
    while (i < order.length) {
      const band = U(460, 620) * S;
      let parts: [number, number][] = [[(mob ? 10 : 30) * S, W - (mob ? 10 : 30) * S]];
      if (!mob && R() < 0.55) { const sp = U(560, 880); parts = [[30, sp], [sp, 1410]]; }
      for (const [x0, x1] of parts) {
        const Wd = x1 - x0, cx = (x0 + x1) / 2, yc = y + band / 2;
        const g = Wd > 900 * S ? pick(['heap', 'diag', 'row', 'arc', 'ring', 'single']) : pick(['heap', 'heap', 'diag', 'single', 'ring']);
        let n = ({ heap: 3 + Math.floor(R() * 4), diag: 3 + Math.floor(R() * 4), row: 4 + Math.floor(R() * 3), arc: 5 + Math.floor(R() * 2), ring: 5 + Math.floor(R() * 3), single: Wd > 900 * S ? 2 : 1 } as any)[g];
        if (mob) n = Math.min(n, 5);
        const ms = order.slice(i, i + n); i += ms.length;
        ms.forEach((m, j) => {
          const t = (j + 0.5) / ms.length;
          if (g === 'heap') put(m, U(300, 420), cx + gauss() * Wd * 0.27, yc + gauss() * band * 0.2);
          else if (g === 'diag') put(m, U(280, 360), x0 + t * Wd + U(-20, 20) * S, yc + (t - 0.5) * band * 0.55);
          else if (g === 'row') put(m, U(280, 350), x0 + t * Wd, yc + U(-25, 25) * S);
          else if (g === 'arc') put(m, U(270, 340), x0 + t * Wd, yc + (0.5 - Math.sin(t * Math.PI)) * band * 0.42);
          else if (g === 'ring') { const a = U(0, 0.4) + (j * 2 * Math.PI) / ms.length, Rr = Math.min(Wd * 0.34, band * 0.36); put(m, U(240, 300), cx + Rr * 1.15 * Math.cos(a), yc + Rr * Math.sin(a)); }
          else put(m, U(360, 460), ms.length > 1 ? x0 + t * Wd : cx + U(-Wd * 0.25, Wd * 0.25), yc + U(-40, 40) * S);
        });
      }
      y += band * (mob ? U(0.6, 0.7) : U(0.7, 0.82));
    }
    board.style.height = `${(maxY + 80) * u}px`;
  }
  layout();

  // Videos laufen, sobald sie zu sehen sind
  const io = new IntersectionObserver((es) => es.forEach((e) => { const v = e.target as HTMLVideoElement; if (e.isIntersecting) { if (!v.getAttribute('src')) v.src = v.dataset.src!; v.play().catch(() => {}); } else v.pause(); }), { threshold: 0.3 });
  board.querySelectorAll('video').forEach((v) => io.observe(v));

  // Anfassen und verschieben
  let drag: { el: HTMLElement; sx: number; sy: number; ox: number; oy: number; id: number } | null = null;
  let lastTap = { el: null as HTMLElement | null, t: 0 };
  const start = (el: HTMLElement, e: PointerEvent) => {
    drag = { el, sx: e.clientX, sy: e.clientY, ox: el.offsetLeft, oy: el.offsetTop, id: e.pointerId };
    el.style.zIndex = String(++topZ); el.classList.add('drag'); el.setPointerCapture(e.pointerId);
  };
  board.addEventListener('pointerdown', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('.fl'); if (!el) return;
    if (e.pointerType === 'mouse' || e.pointerType === 'pen') { e.preventDefault(); start(el, e); return; }
    if (lastTap.el === el && performance.now() - lastTap.t < 420) { e.preventDefault(); start(el, e); }
  });
  board.addEventListener('pointermove', (e) => { if (!drag || e.pointerId !== drag.id) return; drag.el.style.left = `${drag.ox + e.clientX - drag.sx}px`; drag.el.style.top = `${drag.oy + e.clientY - drag.sy}px`; });
  const end = (e: PointerEvent) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('.fl');
    if (drag && e.pointerId === drag.id) { drag.el.classList.remove('drag'); drag.el.style.touchAction = ''; drag = null; lastTap = { el: null, t: 0 }; return; }
    if (el && e.pointerType === 'touch') { lastTap = { el, t: performance.now() }; el.style.touchAction = 'none'; setTimeout(() => { if (!drag || drag.el !== el) el.style.touchAction = ''; }, 450); }
  };
  board.addEventListener('pointerup', end); board.addEventListener('pointercancel', end);
  board.addEventListener('dragstart', (e) => e.preventDefault());
  let rw = innerWidth; addEventListener('resize', () => { if ((innerWidth < 700) !== (rw < 700)) { rw = innerWidth; layout(); } });
</script>
<style>
  :global(.fl-body) { background: #3a1414; }
  .fl-top { display: flex; align-items: baseline; gap: 18px; padding-top: 8px; padding-bottom: 8px; }
  .fl-h { margin: 0; font-size: 12px; letter-spacing: .3em; text-transform: uppercase; color: rgba(240,228,218,.7); font-weight: 500; }
  .fl-hint { font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: rgba(240,228,218,.45); }
  .fl-hint .t { display: none; } @media (pointer: coarse) { .fl-hint .t { display: inline; } .fl-hint .d { display: none; } }
  .fl-board { position: relative; background-color: #3a1414; background-image: var(--paper); background-size: 512px 512px; background-blend-mode: soft-light; overflow: hidden; touch-action: manipulation; user-select: none; -webkit-user-select: none; min-height: 100vh; }
  .fl { position: absolute; cursor: grab; box-shadow: 0 1px 1px rgba(0,0,0,0.28), 0 4px 8px rgba(0,0,0,0.16), 0 18px 34px -12px rgba(0,0,0,0.45); -webkit-touch-callout: none; }
  .fl.drag { cursor: grabbing; filter: drop-shadow(0 26px 30px rgba(0,0,0,.5)); }
  .fl :global(img), .fl video { position: absolute; left: var(--px); top: var(--pt); width: calc(100% - 2 * var(--px)); height: calc(100% - var(--pt) - var(--pb)); object-fit: cover; display: block; pointer-events: none; -webkit-user-drag: none; }
  .k-border { background: #f3f0e9; }
  .k-polaroid { background: #f1eee6; background-image: linear-gradient(180deg, rgba(255,255,255,0.35), rgba(0,0,0,0.03)); }
  .k-torn { background: #f3efe6; box-shadow: none; filter: drop-shadow(0 8px 14px rgba(0,0,0,0.35)); }
  .k-negative { background: #121110; }
  .sp, .e { display: none; }
  .k-negative .sp { display: block; position: absolute; left: 4px; right: 4px; height: calc(14px * var(--fs)); background: #3a1414; mask-image: var(--sprocket); -webkit-mask-image: var(--sprocket); -webkit-mask-size: calc(28px * var(--fs)) calc(14px * var(--fs)); mask-size: calc(28px * var(--fs)) calc(14px * var(--fs)); -webkit-mask-repeat: repeat-x; mask-repeat: repeat-x; }
  .k-negative .sp.t { top: calc(5px * var(--fs)); } .k-negative .sp.b { bottom: calc(5px * var(--fs)); }
  .k-negative .e { display: flex; position: absolute; left: 0; right: 0; height: calc(14px * var(--fs)); align-items: center; padding: 0 calc(14px * var(--fs)); font: 500 calc(10px * var(--fs))/1 var(--f-mono); letter-spacing: .2em; color: #d9823a; white-space: nowrap; overflow: hidden; }
  .k-negative .e.t { top: calc(22px * var(--fs)); } .k-negative .e.b { bottom: calc(22px * var(--fs)); }
</style>
