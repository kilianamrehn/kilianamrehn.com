---
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base lang="en" title="Kilian Amrehn · Artist Portrait Photographer, Cologne" description="Kilian Amrehn photographs artists, musicians and actors in Cologne, Germany: directed, coloured light, a direct gaze, no posing. Also campaigns and reportage.">
<section class="wrap top">
  <h1 class="mono mute">Artist portraits · Cologne, Germany</h1>
  <p class="display claim">Light <span>that searches.</span></p>
  <p class="lead">I photograph people who stand on stages and in front of cameras: music, acting, art. Directed, often coloured light, a lot of darkness around it, and no posing. Based in Cologne, working across Germany and Europe.</p>
  <p class="mono links"><a href={base + 'kuenstlerportraits/'}>Artists →</a> <a href={base + 'kampagnen/'}>Campaigns →</a> <a href={base + 'reportage/'}>Reportage →</a> <a href={base + 'ueber/#kontakt'}>Contact →</a></p>
  <p class="mute small">The full English version is coming soon.</p>
</section>
<Img src="lea-mende-kuenstlerportraet-koeln-rotlicht" alt="Lea Mende in a red room, artist portrait, Cologne" class="hero-img" />
</Base>
<style>
  .top { padding-top: 32px; padding-bottom: 80px; display: flex; flex-direction: column; gap: 24px; }
  .top h1 { font-weight: 400; }
  .claim { font-size: clamp(64px, 10vw, 150px); color: var(--white); }
  .claim span { color: var(--mute); }
  .lead { max-width: 720px; font-size: 20px; color: var(--mute2); }
  .links { display: flex; flex-wrap: wrap; gap: 24px; color: var(--white); }
  .small { font-size: 14px; }
  :global(.hero-img) { width: 100%; height: min(900px, 90svh); object-fit: cover; object-position: center 38%; }
</style>
