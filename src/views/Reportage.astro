---
import '@fontsource-variable/big-shoulders-display';
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import Lightbox from '../components/Lightbox.astro';
import meta from '../data/imgmeta.json';
import { site, routes, type Lang } from '../data/site';
import { T as TT, rows, ausgestellt } from '../data/reportage';
interface Props { lang: Lang }
const { lang } = Astro.props;
const en = lang === 'en';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const t = TT[lang];
const M = meta as Record<string, [number, number, number[]]>;
const ar = (n: string) => M[n][0] / M[n][1];
const full = (n: string) => `${base}img/${n}-${M[n][2][M[n][2].length - 1]}.webp`;
const altOf = (n: string, ch: string) => { const a = ausgestellt[n]; return a ? (en ? a[2] : a[0]) + ' ' + (en ? a[3] : a[1]) : `${ch}, ${t.photo}`; };
const newsTitle = en ? site.newsTitleEn : site.newsTitle;
const article = { '@context': 'https://schema.org', '@type': 'Article', headline: `${newsTitle}: ${t.lead.head}`, author: { '@id': 'https://kilianamrehn.com/#person' }, inLanguage: lang, about: ['Reportage', en ? 'Documentary photography' : 'Dokumentarfotografie', 'Myanmar', 'Moldau', 'Hambacher Forst'] };
---
<Base lang={lang} alternate={routes.reportage[en ? 'de' : 'en']} title={t.title} description={t.description} bodyClass="news-body" schema={[article]}>
<div class="ticker mono"><span>{t.ticker}</span></div>
<div class="paper tisch">
<section class="wrap">
  <div class="dateline mono"><span>{t.issue} {site.newsIssue}</span><span>{t.place}</span><span>{t.byline}</span></div>
  <h1 class="masthead">{newsTitle}<span class="visually-hidden">{t.h1Hidden}</span></h1>
  <div class="rule2"></div>
  <nav class="sections mono" aria-label={t.sectionsLabel}>{['myanmar', 'thailand', 'malaysia', 'moldau', 'protest'].map((id, i) => <a href={`#${id}`}>{t.sections[i]}</a>)}</nav>
</section>

<section class="wrap front">
  <a href="#through-their-eyes" class="lead">
    <span class="mono red">{t.lead.kicker}</span>
    <span class="hl hl-xl">{t.lead.head}</span>
    <span class="stand">{t.lead.stand}</span>
    <figure><Pic name="r-myanmar-1" alt={altOf('r-myanmar-1', 'Myanmar')} sizes="(max-width: 900px) 100vw, 60vw" loading="eager" /><figcaption>{t.exhibited} · {en ? ausgestellt['r-myanmar-1'][2] : ausgestellt['r-myanmar-1'][0]}</figcaption></figure>
  </a>
  <div class="side">
    <a href="#moldau" class="teaser bordered">
      <Pic name="r-moldau-1" alt={altOf('r-moldau-1', en ? 'Moldova 2022' : 'Moldau 2022')} sizes="(max-width: 900px) 100vw, 30vw" />
      <span class="mono red">{t.teaserMoldau.kicker}</span>
      <span class="hl hl-md">{t.teaserMoldau.head}</span>
    </a>
    <a href="#protest" class="teaser">
      <Pic name="r-hambi-1" alt={altOf('r-hambi-1', en ? 'Hambach Forest 2018' : 'Hambacher Forst 2018')} sizes="(max-width: 900px) 100vw, 30vw" />
      <span class="mono red">{t.teaserProtest.kicker}</span>
      <span class="hl hl-md">{t.teaserProtest.head}</span>
    </a>
  </div>
</section>

<article id="through-their-eyes" class="wrap story">
  <div class="rule2"></div>
  <div class="dateline mono"><span>{site.newsIssue} · {t.lead.kicker}</span><span>{t.byline}</span></div>
  <h2 class="hl hl-xxl tte">{t.lead.head}</h2>
  <div class="cols">
    <p><span class="drop">{t.tte.intro2[0]}</span>{t.tte.intro2.slice(1)}</p>
    <div class="col2"><p>{t.tte.intro1}</p><p>{t.tte.intro3}</p></div>
  </div>
</article>

<article id="myanmar" class="wrap story">
  <div class="rule1"></div>
  <div class="ch-head"><span class="mono red">{t.myanmar.kicker}</span><span class="mono muted">{t.myanmar.place}</span></div>
  <blockquote class="hl">{t.myanmar.quote}</blockquote>
  {rows.myanmar.map((r) => (
    <div class="jr">{r.map((n) => (
      <figure class="ph" data-full={full(n)} data-alt={altOf(n, 'Myanmar 2017')} data-cap={'Myanmar 2017'} role="button" tabindex="0" style={`flex:${ar(n)} 1 0`}>
        <Pic name={n} alt={altOf(n, 'Myanmar 2017')} sizes={`(max-width: 900px) 100vw, ${Math.round(ar(n) * 30)}vw`} />
        {ausgestellt[n] && <figcaption><b class="red">{t.exhibited}</b> · <b>{en ? ausgestellt[n][2] : ausgestellt[n][0]}</b> {en ? ausgestellt[n][3] : ausgestellt[n][1]}</figcaption>}
      </figure>
    ))}</div>
  ))}

  <aside class="context">
    <span class="mono red">{t.ctx}</span>
    <span class="hl hl-sm">{t.myanmar.ctxHead}</span>
    {t.myanmar.ctx.map((p) => <p>{p}</p>)}
    <span class="mono src">{t.myanmar.src}</span>
  </aside>

</article>

<article id="thailand" class="wrap story">
  <div class="rule1"></div>
  <div class="ch-head"><span class="mono red">{t.thailand.kicker}</span><span class="mono muted">{t.thailand.place}</span></div>
  <p class="lede">{t.thailand.text}</p>
  {rows.thailand.map((r) => (
    <div class="jr">{r.map((n) => (
      <figure class="ph" data-full={full(n)} data-alt={altOf(n, 'Thailand 2017')} data-cap={'Thailand 2017'} role="button" tabindex="0" style={`flex:${ar(n)} 1 0`}>
        <Pic name={n} alt={altOf(n, 'Thailand 2017')} sizes={`(max-width: 900px) 100vw, ${Math.round(ar(n) * 30)}vw`} />
        {ausgestellt[n] && <figcaption><b class="red">{t.exhibited}</b> · <b>{en ? ausgestellt[n][2] : ausgestellt[n][0]}</b> {en ? ausgestellt[n][3] : ausgestellt[n][1]}</figcaption>}
      </figure>
    ))}</div>
  ))}

  <aside class="context">
    <span class="mono red">{t.ctx}</span>
    <span class="hl hl-sm">{t.thailand.ctxHead}</span>
    {t.thailand.ctx.map((p) => <p>{p}</p>)}
    <span class="mono src">{t.thailand.src}</span>
  </aside>

</article>

<article id="malaysia" class="wrap story">
  <div class="rule1"></div>
  <div class="ch-head"><span class="mono red">{t.malaysia.kicker}</span><span class="mono muted">{t.malaysia.place}</span></div>
  {rows.malaysia.map((r) => (
    <div class="jr">{r.map((n) => (
      <figure class="ph" data-full={full(n)} data-alt={altOf(n, 'Malaysia 2017')} data-cap={'Malaysia 2017'} role="button" tabindex="0" style={`flex:${ar(n)} 1 0`}>
        <Pic name={n} alt={altOf(n, 'Malaysia 2017')} sizes={`(max-width: 900px) 100vw, ${Math.round(ar(n) * 30)}vw`} />
        {ausgestellt[n] && <figcaption><b class="red">{t.exhibited}</b> · <b>{en ? ausgestellt[n][2] : ausgestellt[n][0]}</b> {en ? ausgestellt[n][3] : ausgestellt[n][1]}</figcaption>}
      </figure>
    ))}</div>
  ))}

  <aside class="context">
    <span class="mono red">{t.ctx}</span>
    <span class="hl hl-sm">{t.malaysia.ctxHead}</span>
    {t.malaysia.ctx.map((p) => <p>{p}</p>)}
    <span class="mono src">{t.malaysia.src}</span>
  </aside>

</article>

<article id="moldau" class="wrap story">
  <div class="rule2"></div>
  <div class="dateline mono"><span>{site.newsIssue} · {t.moldau.kicker}</span><span>{t.moldau.byline}</span></div>
  <div class="st-head">
    <h2 class="hl hl-xxl">{t.moldau.head}</h2>
    <dl class="facts mono">
      <dt class="red">{t.moldau.factsTitle}</dt>
      {t.moldau.facts.map((f) => <dd>{f}</dd>)}
    </dl>
  </div>
  <div class="cols">
    <p><span class="drop">W</span><b class="mono">{t.moldau.place}</b> {t.moldau.p1}</p>
    <p>{t.moldau.p2}</p>
  </div>
  <blockquote class="hl" set:html={t.moldau.quote} />
  {rows.moldau.map((r) => (
    <div class="jr">{r.map((n) => (
      <figure class="ph" data-full={full(n)} data-alt={altOf(n, en ? 'Moldova 2022' : 'Moldau 2022')} data-cap={en ? 'Moldova 2022' : 'Moldau 2022'} role="button" tabindex="0" style={`flex:${ar(n)} 1 0`}>
        <Pic name={n} alt={altOf(n, en ? 'Moldova 2022' : 'Moldau 2022')} sizes={`(max-width: 900px) 100vw, ${Math.round(ar(n) * 30)}vw`} />
        {ausgestellt[n] && <figcaption><b class="red">{t.exhibited}</b> · <b>{en ? ausgestellt[n][2] : ausgestellt[n][0]}</b> {en ? ausgestellt[n][3] : ausgestellt[n][1]}</figcaption>}
      </figure>
    ))}</div>
  ))}

</article>

<article id="protest" class="wrap story">
  <div class="rule2"></div>
  <div class="ch-head"><span class="mono red">{t.protest.kicker}</span></div>
  <h2 class="hl hl-xxl">{t.protest.head}</h2>
  <p class="lede">{t.protest.text}</p>
  <span class="mono sub">{t.protest.hambi}</span>
  {rows.hambi.map((r) => (
    <div class="jr">{r.map((n) => (
      <figure class="ph" data-full={full(n)} data-alt={altOf(n, en ? 'Hambach Forest 2018' : 'Hambacher Forst 2018')} data-cap={en ? 'Hambach Forest 2018' : 'Hambacher Forst 2018'} role="button" tabindex="0" style={`flex:${ar(n)} 1 0`}>
        <Pic name={n} alt={altOf(n, en ? 'Hambach Forest 2018' : 'Hambacher Forst 2018')} sizes={`(max-width: 900px) 100vw, ${Math.round(ar(n) * 30)}vw`} />
        {ausgestellt[n] && <figcaption><b class="red">{t.exhibited}</b> · <b>{en ? ausgestellt[n][2] : ausgestellt[n][0]}</b> {en ? ausgestellt[n][3] : ausgestellt[n][1]}</figcaption>}
      </figure>
    ))}</div>
  ))}

  <span class="mono sub">{t.protest.garz}</span>
  <p class="lede small">{t.protest.garzCap}</p>
  {rows.garzweiler.map((r) => (
    <div class="jr">{r.map((n) => (
      <figure class="ph" data-full={full(n)} data-alt={altOf(n, 'Garzweiler 2019')} data-cap={'Garzweiler 2019'} role="button" tabindex="0" style={`flex:${ar(n)} 1 0`}>
        <Pic name={n} alt={altOf(n, 'Garzweiler 2019')} sizes={`(max-width: 900px) 100vw, ${Math.round(ar(n) * 30)}vw`} />
        {ausgestellt[n] && <figcaption><b class="red">{t.exhibited}</b> · <b>{en ? ausgestellt[n][2] : ausgestellt[n][0]}</b> {en ? ausgestellt[n][3] : ausgestellt[n][1]}</figcaption>}
      </figure>
    ))}</div>
  ))}

  <aside class="context">
    <span class="mono red">{t.ctx}</span>
    <span class="hl hl-sm">{t.protest.ctxHead}</span>
    {t.protest.ctx.map((p) => <p>{p}</p>)}
    <span class="mono src">{t.protest.src}</span>
  </aside>

  <div class="rule1 gap"></div>
  <div class="ch-head"><span class="mono red">{t.protest.blmKicker}</span></div>
  <h3 class="hl hl-xl">{t.protest.blmHead}</h3>
  <p class="lede">{t.protest.blmText}</p>
  {rows.blm.map((r) => (
    <div class="jr">{r.map((n) => (
      <figure class="ph" data-full={full(n)} data-alt={altOf(n, en ? 'Black Lives Matter, Cologne 2020' : 'Black Lives Matter, Köln 2020')} data-cap={en ? 'Black Lives Matter, Cologne 2020' : 'Black Lives Matter, Köln 2020'} role="button" tabindex="0" style={`flex:${ar(n)} 1 0`}>
        <Pic name={n} alt={altOf(n, en ? 'Black Lives Matter, Cologne 2020' : 'Black Lives Matter, Köln 2020')} sizes={`(max-width: 900px) 100vw, ${Math.round(ar(n) * 30)}vw`} />
        {ausgestellt[n] && <figcaption><b class="red">{t.exhibited}</b> · <b>{en ? ausgestellt[n][2] : ausgestellt[n][0]}</b> {en ? ausgestellt[n][3] : ausgestellt[n][1]}</figcaption>}
      </figure>
    ))}</div>
  ))}

</article>

<section class="wrap">
  <div class="pubs mono"><span class="muted">{t.pubs}</span><span>Bündnis Entwicklung Hilft · Kindernothilfe · Tagesspiegel · Staatspreis Manufactum 2021</span></div>
</section>
</div>
<Lightbox lang={lang} />
<div class="wrap back"><a href={base + routes.home[lang]} class="display">{t.back}</a></div>
</Base>
<style>
  .jr { display: flex; gap: 14px; padding-top: 14px; align-items: flex-start; }
  .jr figure { margin: 0; min-width: 0; cursor: zoom-in; }
  .jr :global(img), .front :global(img) { width: 100%; height: auto; display: block; }
  .ch-head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; padding-top: 18px; }
  .rule1 { border-top: 1px solid var(--news-ink); }
  .rule1.gap { margin-top: 72px; }
  .tte { padding-top: 32px; }
  .col2 { display: flex; flex-direction: column; gap: 1em; }
  .col2 p, .cols p { margin: 0; }
  .lede { max-width: 62ch; font-size: 19px; line-height: 1.6; margin: 24px 0 18px; }
  .lede.small { font-size: 15px; margin: 6px 0 4px; color: #2b2723; }
  .sub { display: block; margin-top: 40px; color: var(--news-mute); text-transform: uppercase; letter-spacing: .14em; font-size: 12px; }
  .context { margin-top: 40px; }
  .context p { margin: 0; }
  .src { font-size: 11px; color: var(--news-mute); }
  @media (max-width: 700px) { .jr { flex-wrap: wrap; } .jr figure { flex: 1 1 100% !important; } }

  .ticker { background: var(--news-ink); color: var(--news-paper); white-space: nowrap; overflow: hidden; padding: 10px 0; }
  .ticker span { display: inline-block; padding-left: 100%; animation: tick 45s linear infinite; }
  @keyframes tick { to { transform: translateX(-100%); } }
  .paper { background: var(--news-paper); color: var(--news-ink); padding-top: 28px; padding-bottom: 100px; }
  .paper a:hover { color: var(--news-ink); }
  .dateline { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 16px; color: var(--news-mute); padding: 12px 0 10px; border-bottom: 1px solid var(--news-ink); }
  .masthead, .hl { font-family: var(--f-news); font-weight: 900; text-transform: uppercase; letter-spacing: -.005em; }
  .masthead { font-size: clamp(72px, 16.4vw, 236px); line-height: .9; text-align: center; padding: 10px 0 6px; }
  .rule2 { border-top: 3px solid var(--news-ink); border-bottom: 1px solid var(--news-ink); height: 3px; }
  .sections { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 32px; padding: 14px 0; border-bottom: 1px solid var(--news-ink); }
  .red { color: var(--news-red); }
  .hl-xxl { font-size: clamp(56px, 8.3vw, 120px); line-height: .9; }
  .hl-xl { font-size: clamp(48px, 7.2vw, 104px); line-height: .92; }
  .hl-md { font-size: clamp(32px, 3.2vw, 46px); line-height: .95; }
  .hl-sm { font-size: clamp(30px, 3vw, 44px); line-height: .95; }
  figure { display: flex; flex-direction: column; gap: 8px; }
  figcaption { font-family: var(--f-mono); font-size: 11px; line-height: 1.5; color: var(--news-mute); }
  .front { display: grid; grid-template-columns: 2fr 1fr; padding-top: 40px; }
  .lead { padding-right: 40px; border-right: 1px solid var(--news-ink); display: flex; flex-direction: column; gap: 16px; }
  .stand { font-size: clamp(18px, 1.6vw, 22px); line-height: 1.4; color: #2b2723; }
  .side { padding-left: 40px; display: flex; flex-direction: column; gap: 28px; }
  .teaser { display: flex; flex-direction: column; gap: 10px; }
  .bordered { padding-bottom: 28px; border-bottom: 1px solid var(--news-ink); }
  .story { padding-top: clamp(80px, 8vw, 120px); scroll-margin-top: 20px; }
  .st-head { display: grid; grid-template-columns: 2fr 1fr; gap: 40px; padding-top: 40px; }
  .facts { border: 1px solid var(--news-ink); padding: 22px; margin: 0; display: flex; flex-direction: column; gap: 10px; align-self: start; line-height: 1.7; }
  .facts dd { margin: 0; }
  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; padding-top: 40px; font-size: 19px; line-height: 1.65; }
  .cols b { font-size: 13px; }
  .drop { float: left; font-family: var(--f-news); font-weight: 900; font-size: 112px; line-height: .8; padding: 8px 12px 0 0; }
  .g21 { display: grid; grid-template-columns: 2fr 1fr; gap: 16px; padding-top: 56px; }
  .g21.top { gap: 48px; padding-top: 40px; }
  .g12 { display: grid; grid-template-columns: 1fr 2fr; gap: 48px; padding-top: 40px; }
  .g11 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .g11 :global(.span2) { grid-column: span 2; }
  .g111 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; }
  .st-text { display: flex; flex-direction: column; gap: 20px; }
  .st-text p { font-size: 19px; line-height: 1.6; }
  blockquote { margin: 72px 0; padding: 36px 0; border-top: 1px solid var(--news-ink); border-bottom: 1px solid var(--news-ink); font-size: clamp(40px, 5.3vw, 76px); line-height: 1; text-align: center; }
  .context { background: #e2dccf; padding: 26px; display: flex; flex-direction: column; gap: 14px; align-self: start; font-size: 15px; line-height: 1.5; }
  .archive { display: grid; grid-template-columns: 1fr 1fr 1fr; padding-top: 32px; }
  .archive > div { display: flex; flex-direction: column; gap: 12px; padding: 0 32px; border-left: 1px solid var(--news-ink); }
  .archive > div:first-child { padding-left: 0; border-left: 0; }
  .archive p { font-size: 16px; line-height: 1.55; }
  .pubs { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px; border-top: 1px solid var(--news-ink); margin-top: 100px; padding-top: 18px; }
  .muted { color: var(--news-mute); }
  .back { display: flex; justify-content: flex-end; padding-top: 56px; padding-bottom: 24px; }
  .back a { font-size: clamp(32px, 3.3vw, 48px); }
  @media (max-width: 900px) {
    .front, .st-head, .cols, .g21, .g12, .g111, .archive { grid-template-columns: 1fr; }
    .lead { padding-right: 0; border-right: 0; padding-bottom: 32px; border-bottom: 1px solid var(--news-ink); }
    .side { padding-left: 0; padding-top: 32px; }
    .archive > div { padding: 24px 0; border-left: 0; border-top: 1px solid var(--news-ink); }
    .archive > div:first-child { border-top: 0; }
    .cols { gap: 16px; }
  }
</style>
