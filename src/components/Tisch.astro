---
// Bögen mit Bildern in Rahmen (Daten aus tools/tisch.py). Desktop- und Handy-Ebene, Umschalten bei 700px.
// Bilder lassen sich groß ansehen (Vollansicht), Videos starten erst, wenn sie im Bild sind.
import Pic from './Pic.astro';
import Ton from './Ton.astro';
const TON = new Set(['silent-escape-bts']); // Videos mit Ton
import meta from '../data/imgmeta.json';
import type { Lang } from '../data/site';
interface Item { name: string; video: boolean; lt: number; is: string; wrap: string; e: string[] | null; fnum: number | null; sp: string | null; spt?: number; s1?: string; s2?: string; ki: boolean }
interface Layer { h: number; imgs: Item[]; back?: { lt: number; s: string }[] }
interface Sheet { href?: string; bg: string; label?: string; labelEn?: string; note?: string | null; noteEn?: string | null; d: Layer; m: Layer; id?: string }
interface Props { sheets: Sheet[]; lang: Lang; alt: (name: string, i: number) => string; caption?: string; first?: boolean }
const { sheets, lang, alt, caption = '', first = false } = Astro.props;
const en = lang === 'en';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const PX = /(-?\d*\.?\d+)px/g;
const cv = (s: string) => s.replaceAll('__B__', base).replace(PX, (_, n) => `calc(${n}*var(--u))`);
const EDGE_EN: Record<string, string> = {
  KAMPAGNENFOTOGRAFIE: 'CAMPAIGN PHOTOGRAPHY', MODEFOTOGRAFIE: 'FASHION PHOTOGRAPHY', 'FREIE STRECKE': 'PERSONAL SERIES', EDITORIAL: 'EDITORIAL', KAMPAGNE: 'CAMPAIGN',
  SCHMUCKFOTOGRAFIE: 'JEWELLERY PHOTOGRAPHY', DESSOUSFOTOGRAFIE: 'LINGERIE PHOTOGRAPHY', 'GERICHTETES LICHT': 'DIRECTED LIGHT', 'KEIN KI-BILD': 'NOT AN AI IMAGE', SPORTFOTOGRAFIE: 'SPORTS PHOTOGRAPHY',
  'SECOND HAND': 'SECOND HAND', MAGAZIN: 'MAGAZINE', 'ANALOG UND DIGITAL': 'ANALOGUE AND DIGITAL', FLASHES: 'FLASHES', 'KÖLN': 'COLOGNE',
};
const edge = (i: Item, k: 0 | 1) => {
  if (!i.e) return '';
  const w = en ? EDGE_EN[i.e[k]] ?? i.e[k] : i.e[k];
  return k ? `${(i.fnum ?? 0) + 1}  ◂  ${w}` : `${i.fnum}A  ▸  ${w}`;
};
const full = (n: string) => {
  const m = (meta as Record<string, [number, number, number[]]>)[n];
  return m ? `${base}img/${n}-${m[2][m[2].length - 1]}.webp` : '';
};
const num = (s: string) => Number((s.match(/width:([\d.]+)px/) || [])[1] || 0);
let k = 0;
---
<div class="tisch">
{sheets.map((s) => (
  <section class="sheet" id={s.id} data-href={s.href} style={`--bg:${s.bg};--paper:url(${base}media/marks/paper.png)`}>
    <div class="band"></div>
    {(s.label || s.note) && (
      <div class="sh-head">
        {s.label && <h2 class="sh-label">{en ? s.labelEn : s.label}</h2>}
        {s.note && <p class="sh-note">{en ? s.noteEn : s.note}</p>}
      </div>
    )}
    {(['d', 'm'] as const).map((L) => {
      const lay = s[L];
      return (
        <div class={`lay ${L}`} style={`height:calc(${lay.h}*var(--u))`}>
          {(lay.back ?? []).map((b) => <div style={cv(`top:${b.lt}px;` + b.s)}></div>)}
          {lay.imgs.map((i) => {
            const a = alt(i.name, k++);
            const vw = num(i.is);
            const sizes = L === 'd' ? `(max-width: 699px) 1px, ${Math.ceil(vw)}px` : `(max-width: 699px) ${Math.ceil((vw / 390) * 100)}vw, 1px`;
            return (
              <div class="ph" style={cv(`top:${i.lt}px;` + i.wrap)} data-full={i.video ? undefined : full(i.name)} data-video={i.video ? `${base}media/video/${i.name}.mp4` : undefined} data-alt={a} data-cap={caption} data-ton-lb={i.video && TON.has(i.name) && !s.href ? '' : undefined} role="button" tabindex="0">
                {i.sp && <div style={cv(i.sp + `top:${i.spt}px`)}></div>}
                {i.e && <div style={cv(i.s1 ?? '')}>{edge(i, 0)}</div>}
                {i.video
                  ? <video data-src={`${base}media/video/${i.name}.mp4`} poster={`${base}img/v-${i.name}.webp`} muted loop playsinline preload="none" style={cv(i.is) + 'object-fit:cover;'} aria-label={a}></video>
                  : <Pic name={i.name} alt={a} style={cv(i.is) + 'object-fit:cover;'} sizes={sizes} loading={first && k < 3 ? 'eager' : 'lazy'} />}
                {i.e && <div style={cv(i.s2 ?? '')}>{edge(i, 1)}</div>}
                {i.sp && <div style={cv(i.sp + `bottom:${i.spt}px`)}></div>}
                {i.video && TON.has(i.name) && !s.href && <Ton lang={lang} />}
                {i.ki && <span class="ki">{en ? 'AI VIDEO' : 'KI-VIDEO'}</span>}
              </div>
            );
          })}
        </div>
      );
    })}
  </section>
))}
</div>

<style>
  .tisch { position: relative; }
  .sheet { position: relative; --u: min(1px, calc(100vw / 1440)); }
  .sheet + .sheet .band { top: calc(-14 * var(--u)); box-shadow: 0 -1px 2px rgba(0,0,0,0.3), 0 -10px 26px rgba(0,0,0,0.28); }
  .sheet:nth-child(even) .band { transform: rotate(-0.16deg); }
  .sheet:nth-child(3n) .band { transform: rotate(0.12deg); }
  .band { position: absolute; left: -2%; width: 104%; top: 0; bottom: 0; background-color: var(--bg); background-image: var(--paper); background-size: 512px 512px; background-blend-mode: soft-light; }
  .sh-head { position: absolute; z-index: 40; top: calc(48 * var(--u)); left: calc(44 * var(--u)); right: calc(44 * var(--u)); display: flex; flex-wrap: wrap; gap: 10px 32px; align-items: baseline; pointer-events: none; }
  .sh-label { margin: 0; font: 500 12px/1.2 var(--f-mono); letter-spacing: .22em; text-transform: uppercase; color: rgba(240,228,218,.78); }
  .sh-note { margin: 0; max-width: 60ch; font: 400 15px/1.5 var(--f-text); color: rgba(240,228,218,.9); }
  .lay { position: relative; margin: 0 auto; }
  .lay.d { --u: min(1px, calc(100vw / 1440)); width: calc(1440 * var(--u)); }
  .lay.m { --u: calc(100vw / 390); width: calc(390 * var(--u)); display: none; }
  @media (max-width: 699px) {
    .lay.d { display: none; } .lay.m { display: block; } .sheet { --u: calc(100vw / 390); }
    .sh-head { top: calc(22 * var(--u)); left: calc(14 * var(--u)); right: calc(14 * var(--u)); }
    .sh-note { font-size: 13px; }
  }
  .ph { position: absolute; cursor: zoom-in; }
  .ph:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .ki { position: absolute; right: 8px; bottom: 8px; font: 500 9px/1 var(--f-mono); letter-spacing: .18em; color: rgba(255,255,255,.85); background: rgba(0,0,0,.4); padding: 4px 6px; z-index: 2; }
</style>
