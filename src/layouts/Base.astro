---
import '@fontsource-variable/host-grotesk';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import { site, nav, type Lang } from '../data/site';
import Mail from '../components/Mail.astro';

// alternate: Pfad derselben Seite in der anderen Sprache (ohne Base, z. B. 'en/artists/'). Fehlt er, gibt es die Seite nur auf Deutsch.
interface Props { title: string; description: string; image?: string; lang?: Lang; headerOverlay?: boolean; bodyClass?: string; schema?: object[]; alternate?: string }
const { title, description, image, lang = 'de', headerOverlay = false, bodyClass = '', schema = [], alternate } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const u = (p: string) => base + p.replace(/^\//, '');
const canonical = new URL(Astro.url.pathname, site.url).href.replace(/^(https:\/\/[^/]+)\/kilianamrehn\.com/, '$1');
const path = Astro.url.pathname.replace(base, '/');
// 404-Seite: kein hreflang, Sprachumschalter zeigt auf die Startseiten
const is404 = /^\/?404(\/|\.html)?$/.test(path);
const self = is404 ? '' : path.replace(/^\//, '');
const dePath = lang === 'de' ? self : alternate ?? '';
const enPath = lang === 'en' ? self : alternate;
const abs = (p: string) => site.url + '/' + p;
const en = lang === 'en';
const ogImage = new URL(image ?? '/media/og-kilian-amrehn.jpg', Astro.site).href;

const business = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'ProfessionalService'],
  '@id': site.url + '/#business',
  name: 'Kilian Amrehn Fotografie',
  description: 'Porträts für Artists, Musikfotos, Schauspielporträts und Kampagnen aus Köln.',
  url: site.url,
  email: `${site.mailUser}@${site.mailDomain}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Köln', addressRegion: 'NRW', addressCountry: 'DE' },
  areaServed: ['Köln', 'Düsseldorf', 'Berlin', 'Deutschland', 'Europa'],
  founder: { '@id': site.url + '/#person' },
  sameAs: [site.instagram].filter(Boolean),
};
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': site.url + '/#person',
  name: site.name,
  jobTitle: ['Fotograf', 'App-Entwickler'],
  knowsAbout: ['Porträts für Artists', 'Musikfotografie', 'Schauspielporträts', 'Kampagnenfotografie', 'Reportage', 'App-Entwicklung'],
  address: { '@type': 'PostalAddress', addressLocality: 'Köln', addressCountry: 'DE' },
  url: site.url,
  sameAs: [site.instagram, site.linkedin].filter(Boolean),
};
const ld = [business, person, ...schema];
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
{!is404 && <link rel="alternate" hreflang="de" href={abs(dePath)}>}
{!is404 && enPath !== undefined && <link rel="alternate" hreflang="en" href={abs(enPath)}>}
{!is404 && <link rel="alternate" hreflang="x-default" href={abs(dePath)}>}
<meta property="og:type" content="website">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_US'}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:image" content={ogImage}>
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#22100f">
<link rel="icon" href={u('favicon.svg')} type="image/svg+xml">
<link rel="icon" href={u('favicon-32.png')} type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href={u('favicon-180.png')}>
<link rel="sitemap" href={u('sitemap-index.xml')}>
{ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
</head>
<body class={bodyClass}>
<a class="visually-hidden" href="#inhalt">{en ? 'Skip to content' : 'Zum Inhalt'}</a>
<header class:list={['site-header wrap', { overlay: headerOverlay }]}>
  <a class="brand" href={u(en ? 'en/' : '')} aria-label={en ? 'Kilian Amrehn, home' : 'Kilian Amrehn, Startseite'}><img src={u('media/kilian-logo.svg')} alt="KILIAN" width="729" height="148"></a>
  <a class:list={['lamp', { on: /^\/(en\/)?flashes/.test(path) }]} href={u(en ? 'en/flashes/' : 'flashes/')} data-lamp aria-label="Flashes" title="Flashes">
    <svg viewBox="0 0 40 120" aria-hidden="true"><line x1="20" y1="0" x2="20" y2="70" /><rect x="14" y="66" width="12" height="14" rx="2" /><circle class="bulb" cx="20" cy="94" r="15" /><path class="fil" d="M14 94 q3 -6 6 0 q3 6 6 0" /></svg>
  </a>
  <button type="button" class="burger" data-burger aria-expanded="false" aria-controls="hauptmenue" aria-label={en ? 'Menu' : 'Menü'}><span></span><span></span><span></span></button>
  <nav id="hauptmenue" aria-label={en ? 'Main navigation' : 'Hauptnavigation'}>
    {nav[lang].map((n) => <a href={u(n.href)} aria-current={path.startsWith('/' + n.href) ? 'page' : undefined}>{n.label}</a>)}
    <span class="lang"><a href={u(dePath)} aria-current={lang === 'de' ? 'true' : undefined} hreflang="de" lang="de">DE</a> / <a href={u(enPath ?? 'en/')} aria-current={lang === 'en' ? 'true' : undefined} hreflang="en" lang="en">EN</a></span>
  </nav>
</header>
<main id="inhalt"><slot /></main>
<footer class="site-footer">
  <div class="wrap">
    <div style="display:flex;flex-direction:column;gap:14px">
      <span class="mono mute">{lang === 'de' ? 'Einfach schreiben.' : 'Just write.'}</span>
      <Mail lang={lang} />
    </div>
    <div class="footer-links">
      <a href={site.instagram} rel="me noopener" target="_blank">Instagram</a>
      {site.linkedin && <a href={site.linkedin} rel="me noopener" target="_blank">LinkedIn</a>}
      {!en && <a href={u('portraitfotografie/')}>Portraitfotografie Köln</a>}
      <a href={u('impressum/')} hreflang={en ? 'de' : undefined}>{en ? 'Imprint' : 'Impressum'}</a>
      <a href={u('datenschutz/')} hreflang={en ? 'de' : undefined}>{en ? 'Privacy' : 'Datenschutz'}</a>
    </div>
  </div>
</footer>
<div class="darkroom" aria-hidden="true"></div>
<script>
  document.querySelectorAll<HTMLElement>('[data-today]').forEach((el) => { el.textContent = new Date().toLocaleDateString(el.dataset.today === 'en' ? 'en-GB' : 'de-DE', { day: 'numeric', month: 'long', year: 'numeric' }); });
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  burger?.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') !== 'true';
    burger.setAttribute('aria-expanded', String(open)); document.documentElement.classList.toggle('menu-open', open);
  });
  document.querySelectorAll('#hauptmenue a').forEach((a) => a.addEventListener('click', () => { burger?.setAttribute('aria-expanded', 'false'); document.documentElement.classList.remove('menu-open'); }));
  document.querySelectorAll<HTMLAnchorElement>('[data-lamp]').forEach((a) => a.addEventListener('click', (e) => {
    if (a.classList.contains('on')) return;
    e.preventDefault(); a.classList.add('on'); document.documentElement.classList.add('in-darkroom');
    setTimeout(() => { location.href = a.href; }, matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 700);
  }));
</script>
</body>
</html>
<style>
  .overlay { position: absolute; top: 0; left: 0; right: 0; max-width: none; }
  @media (min-width: 1536px) { .overlay { padding-left: calc((100vw - var(--max)) / 2 + var(--pad)); padding-right: calc((100vw - var(--max)) / 2 + var(--pad)); } }
</style>
