import { FAQ_PRICE, FAQ_TIME, FAQ_SPEED, FAQ_USE, FAQ_STUDIO, FAQ_HMU, FAQ_WEAR, FAQ_UNFOTOGEN } from '../data/leistung';
---
<Leistung
  og="/media/og/kunst-literatur.jpg"
  title="Porträts für Kunst und Literatur Köln · Kilian Amrehn"
  description="Porträts für Malerinnen, Maler, Autorinnen und Autoren in Köln: Fotos für Buchumschlag, Verlag, Katalog, Galerie und Presse. Im Atelier oder am Schreibtisch."
