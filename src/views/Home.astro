---
import '@fontsource-variable/big-shoulders-display';
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import { site, routes, type Lang } from '../data/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const u = (p: string) => base + p;
const r = (k: keyof typeof routes) => routes[k][lang];

const T = {
  de: {
    title: 'Künstlerporträts Köln · Musikerfotos & Schauspielporträts · Kilian Amrehn',
    description: 'Kilian Amrehn fotografiert Künstlerinnen und Künstler in Köln: Musikerfotos, Pressefotos, EP-Cover und Schauspielporträts mit gerichtetem, farbigem Licht. Keine Pose.',
    h1: 'Künstlerporträts in Köln',
    claim: 'Licht,<br><span>das sucht.</span>',
    chips: 'Licht wählen',
    looks: {
      rot: { caption: 'Rotlicht · Kelly', alt: 'Kelly im roten Licht über einem Röhrenfernseher, Künstlerporträt Köln', label: 'Rotes Licht' },
      gold: { caption: 'Gold · Marie, analog', alt: 'Marie in einem goldenen Lichtstreif, analog fotografiert', label: 'Goldenes Licht' },
      gruen: { caption: 'Grüner Lichtstreif · Parzhuber Trio', alt: 'Parzhuber Trio, Band-Pressefoto zwischen Pflanzen mit grünem Lichtstreif', label: 'Grünes Licht' },
      tuerkis: { caption: 'Türkis · Paula', alt: 'Paula, DJ, doppelt belichtet im türkisen Licht', label: 'Türkises Licht' },
      rosa: { caption: 'Rosa und Himmel · Dan O’Clock', alt: 'Dan O’Clock im rosa Fellmantel vor Wolkenhimmel, Musikerporträt', label: 'Rosa Licht' },
    },
    eyes: [
      'Augen, Kelly, Blick von unten in die Kamera',
      'Augen, Pia Stutzenstein, zusammengekniffen mit Seitenblick',
      'Ein Auge, Paula, im orangen Licht',
      'Augen, Slavko Popadic, Blick in die Kamera',
      'Augen, Parzhuber Trio, im roten Licht',
    ],
    strips: 'Arbeiten auf Negativstreifen',
    stripsHead: ['Arbeiten 2017 bis heute', 'läuft einfach'],
    stripAlt: 'Negativstreifen mit Porträts und Kampagnen von Kilian Amrehn',
    runon: 'Künstlerporträts Köln · Musikporträts · Pressefotos für Bands und Solo-Artists · EP- und Albumcover · Schauspielporträts · <em>gerichtetes Licht</em> · farbiges Licht · Dunkelheit, die etwas verbirgt · <em>ein Blick direkt in die Kamera</em> · eine Bewegung, kurz bevor sie endet · <em>keine Pose</em> · Köln, Berlin, Europa · <b>Morley</b> · <b>Bianca Berding</b> · <b>Lea Mende</b> · Menschen so zeigen, wie sie sich selbst noch nicht gesehen haben.',
    doorArtists: ['Artists', 'Musik · Schauspiel · Kunst'],
    doorCampaigns: ['Kampagnen', 'Marken &amp; Editorial'],
    clipTop: 'Köln · Oktober 2026',
    newsTitle: site.newsTitle,
    clipAlt: 'Ein Mann und ein Kind vor einer Haustür, Moldau 2022',
    clipKicker: 'Flucht · Moldau 2022',
    clipHead: 'Das ärmste Land Europas lässt 450.000 Menschen durch',
    clipPlace: 'Moldau, 2022 ·',
    clipText: 'Was bleibt, ist ein Gefühl. Das Gefühl, dass wir nicht genug tun und sie nicht genug haben. Nach einem Tag in Flüchtlingslagern, an der Grenze zur Ukraine, in Gesprächen mit Geflüchteten und in Lagerhallen bin ich vor allem beeindruckt.',
  },
  en: {
    title: 'Artist Portrait Photographer Cologne · Musicians & Actors · Kilian Amrehn',
    description: 'Kilian Amrehn photographs artists in Cologne: musician photos, press photos, EP covers and actor portraits with directed, colored light. No posing.',
    h1: 'Artist portraits in Cologne',
    claim: 'Light<br><span>that searches.</span>',
    chips: 'Choose the light',
    looks: {
      rot: { caption: 'Red light · Kelly', alt: 'Kelly in red light above a CRT television, artist portrait Cologne', label: 'Red light' },
      gold: { caption: 'Gold · Marie, on film', alt: 'Marie in a streak of golden light, shot on film', label: 'Golden light' },
      gruen: { caption: 'Green streak of light · Parzhuber Trio', alt: 'Parzhuber Trio, band press photo among plants with a streak of green light', label: 'Green light' },
      tuerkis: { caption: 'Turquoise · Paula', alt: 'Paula, DJ, double exposure in turquoise light', label: 'Turquoise light' },
      rosa: { caption: 'Pink and sky · Dan O’Clock', alt: 'Dan O’Clock in a pink fur coat against a cloudy sky, musician portrait', label: 'Pink light' },
    },
    eyes: [
      'Eyes, Kelly, looking up into the camera',
      'Eyes, Pia Stutzenstein, narrowed with a sideways glance',
      'One eye, Paula, in orange light',
      'Eyes, Slavko Popadic, looking into the camera',
      'Eyes, Parzhuber Trio, in red light',
    ],
    strips: 'Work on negative strips',
    stripsHead: ['Work from 2017 to today', 'keeps running'],
    stripAlt: 'Negative strips with portraits and campaigns by Kilian Amrehn',
    runon: 'Artist portraits Cologne · music portraits · press photos for bands and solo artists · EP and album covers · actor portraits · <em>directed light</em> · colored light · darkness that hides something · <em>a look straight into the camera</em> · a movement just before it ends · <em>no posing</em> · Cologne, Berlin, Europe · <b>Morley</b> · <b>Bianca Berding</b> · <b>Lea Mende</b> · showing people the way they have never seen themselves.',
    doorArtists: ['Artists', 'Music · Acting · Art'],
    doorCampaigns: ['Campaigns', 'Brands &amp; Editorial'],
    clipTop: 'Cologne · October 2026',
    newsTitle: site.newsTitleEn,
    clipAlt: 'A man and a child in front of a front door, Moldova 2022',
    clipKicker: 'Refugees · Moldova 2022',
    clipHead: 'Europe’s poorest country lets 450,000 people through',
    clipPlace: 'Moldova, 2022 ·',
    clipText: 'What remains is a feeling. The feeling that we are not doing enough and they do not have enough. After a day in refugee camps, at the border with Ukraine, talking with refugees and in warehouses, I am above all impressed.',
  },
};
const t = T[lang];

const looks = [
  { k: 'rot', src: 'kelly-portraet-rotlicht', pos: 'center 30%', bg: '#1a0403', dot: '#b8302a' },
  { k: 'gold', src: 'marie-portraet-goldenes-licht-analog', pos: 'center 55%', bg: '#150e04', dot: '#f0c65a' },
  { k: 'gruen', src: 'parzhuber-trio-band-pressefoto-gruenes-licht', pos: 'center 50%', bg: '#0b1206', dot: '#3f8f3a' },
  { k: 'tuerkis', src: 'paula-dj-portraet-tuerkises-licht', pos: 'center 35%', bg: '#031314', dot: '#2fb8b0' },
  { k: 'rosa', src: 'dan-oclock-musiker-portraet-rosa', pos: 'center 40%', bg: '#0e1a24', dot: '#f2b3cf' },
].map((l) => ({ ...l, ...t.looks[l.k as keyof typeof t.looks] }));
const eyes = ['augen-kelly', 'augen-pia-stutzenstein', 'auge-paula-dj', 'augen-slavko-popadic', 'augen-parzhuber-trio'].map((s, i) => [s, t.eyes[i]]);
const bands = [['Copenhagen Studios', '#6a2a0c'], ['Peek & Cloppenburg x Ellesse', '#2b3020'], ['Rock Fairyland', '#1d1d1d'], ['Scholl', '#3a2f22'], ['AppelrathCüpper', '#26303a']];
---
<Base lang={lang} alternate={routes.home[lang === 'de' ? 'en' : 'de']} title={t.title} description={t.description} headerOverlay image="/media/making-of-poster.jpg">
<section class="hero" data-hero style={`background:${looks[0].bg}`}>
  {looks.map((l, i) => (
    <div class="look" data-look={l.k} data-bg={l.bg} data-caption={l.caption} hidden={i !== 0}>
      <Img src={l.src} alt="" pos={l.pos} class="cover base" loading={i === 0 ? 'eager' : 'lazy'} />
      <Img src={l.src} alt={l.alt} pos={l.pos} class="cover lit" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} />
    </div>
  ))}
  <div class="shade"></div>
  <div class="hero-text wrap">
    <div>
      <h1 class="mono">{t.h1}</h1>
      <p class="display claim" set:html={t.claim} />
    </div>
    <div class="chips-box">
      <span class="mono caption" data-caption-out>{looks[0].caption}</span>
      <div class="chips" role="group" aria-label={t.chips}>
        {looks.map((l, i) => <button type="button" data-pick={l.k} aria-label={l.label} aria-pressed={i === 0 ? 'true' : 'false'} style={`background:${l.dot}`}></button>)}
      </div>
    </div>
  </div>
</section>

<section class="strips" aria-label={t.strips}>
  <div class="wrap mono strips-head"><span>{t.stripsHead[0]}</span><span>{t.stripsHead[1]}</span></div>
  <div class="strip-rows">
    {[['kontaktabzug-negativstreifen-1', 'a'], ['kontaktabzug-negativstreifen-2', 'b']].map(([s, d]) => (
      <div class={`row row-${d}`}>
        <Img src={s} alt={t.stripAlt} class="neg" sizes="(max-width: 720px) 2430px, 4860px" widths={[2430, 4860, 6400]} />
        <Img src={s} alt="" class="neg" sizes="(max-width: 720px) 2430px, 4860px" widths={[2430, 4860, 6400]} />
      </div>
    ))}
  </div>
</section>

<section class="wrap intro">
  <p class="runon" set:html={t.runon} />
</section>

<section class="wrap doors">
  <a href={u(r('artists'))} class="door">
    <div class="stack">{eyes.map(([s, a]) => <Img src={s} alt={a} class="strip" sizes="(max-width: 900px) 100vw, 50vw" widths={[480, 800, 1150]} />)}</div>
    <div class="door-label"><span class="display">{t.doorArtists[0]}</span><span class="mono mute"><Fragment set:html={t.doorArtists[1]} /> <b class="arr">→</b></span></div>
  </a>
  <a href={u(r('campaigns'))} class="door">
    <div class="stack mono">{bands.map(([n, c]) => <span class="band" style={`background:${c}`}>{n}</span>)}</div>
    <div class="door-label"><span class="display">{t.doorCampaigns[0]}</span><span class="mono mute"><Fragment set:html={t.doorCampaigns[1]} /> <b class="arr">→</b></span></div>
  </a>
</section>

<section class="wrap clip-wrap">
  <a href={u(r('reportage'))} class="clip">
    <div class="clip-top mono"><span>{site.newsIssue} · {t.clipTop}</span><span>Reportage</span></div>
    <div class="clip-title">{t.newsTitle}</div>
    <div class="rule2"></div>
    <div class="clip-body">
      <Img src="moldau-2022-mann-und-kind" alt={t.clipAlt} pos="center 40%" class="clip-img" sizes="(max-width: 900px) 100vw, 55vw" widths={[480, 800, 1200]} />
      <div class="clip-text">
        <span class="mono red">{t.clipKicker}</span>
        <span class="clip-head">{t.clipHead}</span>
        <p><b class="mono">{t.clipPlace}</b> {t.clipText}</p>
      </div>
    </div>
  </a>
</section>
</Base>

<style>
  .hero { position: relative; height: min(920px, 100svh); min-height: 560px; overflow: hidden; cursor: crosshair; transition: background-color .4s; }
  .look, .look :global(picture) { position: absolute; inset: 0; }
  .look[hidden] { display: none; }
  .hero :global(.base) { position: absolute; inset: 0; opacity: .07; }
  .hero :global(.lit) { position: absolute; inset: 0; -webkit-mask-image: var(--mask); mask-image: var(--mask); }
  .hero { --mask: radial-gradient(circle 125px at 56% 40%, #000 0%, #000 35%, transparent 100%); }
  .shade { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(180deg, rgba(34,16,15,.6) 0%, rgba(34,16,15,0) 26%, rgba(34,16,15,0) 55%, rgba(34,16,15,.9) 100%); }
  .hero-text { position: absolute; left: 0; right: 0; bottom: clamp(28px, 5vw, 52px); display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 28px; pointer-events: none; }
  .hero h1 { font-weight: 400; color: var(--mute2); margin-bottom: 18px; }
  .claim { font-size: clamp(64px, 10.4vw, 150px); line-height: .86; color: var(--white); }
  .claim :global(span) { color: var(--mute); }
  .chips-box { display: flex; flex-direction: column; align-items: flex-end; gap: 14px; pointer-events: auto; }
  .caption { color: var(--mute2); }
  .chips { display: flex; gap: 12px; }
  .chips button { width: 44px; height: 44px; border-radius: 999px; border: 1px solid rgba(244,238,228,.35); padding: 0; cursor: pointer; }
  .chips button[aria-pressed='true'] { border: 3px solid var(--white); }
  @media (hover: none) { .hero :global(.lit) { -webkit-mask-image: none; mask-image: none; } .hero { cursor: default; } }
  @media (max-width: 720px) { .chips-box { align-items: flex-start; } .chips button { width: 48px; height: 48px; } }


  .strips { overflow: hidden; padding: 34px 0 40px; }
  .strips-head { display: flex; justify-content: space-between; gap: 24px; color: var(--mute); padding-top: 22px; padding-bottom: 18px; }
  .strip-rows { display: flex; flex-direction: column; gap: 26px; }
  .row { display: flex; width: max-content; animation: slide 160s linear infinite; will-change: transform; }
  .row-b { animation-duration: 190s; animation-direction: reverse; }
  .row :global(picture) { display: block; flex: none; }
  .row :global(.neg) { height: clamp(300px, 41.7vw, 600px); width: auto; max-width: none; }
  @keyframes slide { to { transform: translateX(-50%); } }

  .intro { padding-top: clamp(80px, 10vw, 140px); padding-bottom: clamp(80px, 10vw, 140px); }
  .doors { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; padding-bottom: 80px; }
  .door { display: flex; flex-direction: column; gap: 20px; }
  .stack { display: flex; flex-direction: column; gap: 4px; }
  .stack :global(.strip) { width: 100%; height: clamp(52px, 5.3vw, 76px); object-fit: cover; }
  .band { height: clamp(52px, 5.3vw, 76px); display: flex; align-items: center; padding: 0 20px; color: var(--white); }
  .door-label { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 20px; }
  .arr { font-weight: 400; color: var(--accent); display: inline-block; transition: transform .25s; }
  .door:hover .arr { transform: translateX(6px); }
  .door:hover .display { color: var(--white); }
  .door-label .display { font-size: clamp(44px, 4.4vw, 64px); line-height: 1; }
  @media (max-width: 900px) { .doors { grid-template-columns: 1fr; gap: 48px; } }

  .clip-wrap { padding-top: 40px; padding-bottom: clamp(100px, 11vw, 160px); }
  .clip { display: block; transform: rotate(-.8deg); background: var(--news-paper); color: var(--news-ink); box-shadow: 0 30px 60px rgba(0,0,0,.55); padding: 28px clamp(18px, 2.5vw, 36px) 0; overflow: hidden; }
  .clip:hover { color: var(--news-ink); transform: rotate(-.4deg); transition: transform .3s; }
  .clip-top { display: flex; justify-content: space-between; gap: 16px; color: var(--news-mute); padding-bottom: 10px; border-bottom: 1px solid var(--news-ink); }
  .clip-title { font-family: var(--f-news); font-weight: 900; text-transform: uppercase; font-size: clamp(64px, 10.4vw, 150px); line-height: .92; text-align: center; padding: 8px 0 4px; }
  .rule2 { border-top: 3px solid var(--news-ink); border-bottom: 1px solid var(--news-ink); height: 3px; }
  .clip-body { display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(20px, 2.5vw, 36px); padding-top: 28px; height: 380px; }
  .clip-body :global(.clip-img) { width: 100%; height: 352px; object-fit: cover; filter: grayscale(1) contrast(1.08); }
  .clip-text { display: flex; flex-direction: column; gap: 14px; -webkit-mask-image: linear-gradient(180deg, #000 60%, transparent 100%); mask-image: linear-gradient(180deg, #000 60%, transparent 100%); }
  .red { color: var(--news-red); }
  .clip-head { font-family: var(--f-news); font-weight: 900; text-transform: uppercase; font-size: clamp(36px, 3.8vw, 54px); line-height: .95; }
  .clip-text p { font-size: 17px; line-height: 1.55; }
  @media (max-width: 900px) { .clip-body { grid-template-columns: 1fr; height: auto; max-height: 640px; } .clip-body :global(.clip-img) { height: 260px; } }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) {
    const start = [{ x: 50, y: 34 }, { x: 53, y: 37 }, { x: 56, y: 40 }];
    let pts = start.slice();
    const draw = () => {
      const n = pts.length;
      hero.style.setProperty('--mask', pts.map((p, i) => `radial-gradient(circle ${Math.round(30 + 95 * ((i + 1) / n))}px at ${p.x}% ${p.y}%, #000 0%, #000 35%, transparent 100%)`).join(', '));
    };
    draw();
    let raf = 0;
    hero.addEventListener('pointermove', (e) => {
      if (e.pointerType === 'touch') return;
      const r = hero.getBoundingClientRect();
      const x = Math.round(((e.clientX - r.left) / r.width) * 1000) / 10;
      const y = Math.round(((e.clientY - r.top) / r.height) * 1000) / 10;
      const last = pts[pts.length - 1];
      if (last && Math.abs(last.x - x) + Math.abs(last.y - y) < 1.5) return;
      pts = pts.concat([{ x, y }]).slice(-28);
      cancelAnimationFrame(raf); raf = requestAnimationFrame(draw);
    });
    const cap = hero.querySelector<HTMLElement>('[data-caption-out]');
    hero.querySelectorAll<HTMLButtonElement>('[data-pick]').forEach((b) => {
      b.addEventListener('click', (e) => {
        e.stopPropagation();
        const k = b.dataset.pick;
        hero.querySelectorAll<HTMLElement>('.look').forEach((l) => {
          const on = l.dataset.look === k; l.hidden = !on;
          if (on) { hero.style.backgroundColor = l.dataset.bg || ''; if (cap) cap.textContent = l.dataset.caption || ''; }
        });
        hero.querySelectorAll('[data-pick]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        pts = start.slice(); draw();
      });
    });
  }
</script>
