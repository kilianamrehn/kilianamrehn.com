---
import { site, type Lang } from '../data/site';
interface Props { class?: string; lang?: Lang }
const { class: cls = 'mail', lang = 'de' } = Astro.props;
---
<button type="button" class={cls} data-mail={`${site.mailUser}|${site.mailDomain}`.split('').reverse().join('')} aria-label={lang === 'en' ? 'Write an email' : 'E-Mail schreiben'}>{site.mailUser}<span>[at]</span>{site.mailDomain.replace('.com', '')}<span>.</span>com</button>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-mail]').forEach((b) => {
    b.addEventListener('click', () => {
      const [u, d] = (b.dataset.mail || '').split('').reverse().join('').split('|');
      window.location.href = 'mailto:' + u + '@' + d;
    });
  });
</script>
