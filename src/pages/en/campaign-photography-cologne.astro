import { FAQ_PRICE_EN, FAQ_TIME_EN, FAQ_SPEED_EN, FAQ_USE_EN, FAQ_STUDIO_EN, FAQ_HMU_EN, FAQ_WEAR_EN, FAQ_UNFOTOGEN_EN } from '../../data/leistung';
---
<Leistung
  lang="en"
  alternate="kampagnenfotografie-koeln/"
  og="/media/og/kampagnen.jpg"
  title="Campaign Photography Cologne · Fashion & Editorial · Kilian Amrehn"
  description="Campaign photography in Cologne: fashion, footwear, jewellery, lingerie and editorials for brands and agencies. From concept to final image, in the studio or on location."
  h1="Campaign Photography Cologne"
  lead="Campaigns and editorials for fashion, footwear, jewellery and lingerie."
  img={{ src: 'w-peek-cloppenburg-x-ellesse-1', alt: 'Peek & Cloppenburg x Ellesse, campaign on a train, campaign photography Cologne', pic: true }}
  text={['For brands and agencies I shoot campaigns and editorials: fashion, footwear, jewellery, lingerie. With teams for styling, hair and make-up, production and film, or pared back to one model and one light.', 'A campaign has to show the product and still sell a feeling. I work with directed, sometimes coloured light and with people who feel at ease in front of the camera. You can see it in the picture.', 'Clients include Peek & Cloppenburg with Ellesse, Scholl, Copenhagen Studios, AppelrathCüpper and the DFL. Alongside them are personal series where I try out ideas before they go into a campaign.', 'In the studio, on location in Cologne or abroad. It starts with a conversation about the brand, the idea and what the pictures need to achieve.']}
  links={[['Peek & Cloppenburg x Ellesse', 'en/campaigns/peek-cloppenburg-x-ellesse/'], ['Copenhagen Studios', 'en/campaigns/copenhagen-studios/'], ['Scholl', 'en/campaigns/scholl-iconic/'], ['AppelrathCüpper', 'en/campaigns/appelrathcuepper/'], ['Rock Fairyland, personal series', 'en/campaigns/rock-fairyland/'], ['All work', 'en/campaigns/']]}
  examples={[{ src: 'w-scholl-3', label: 'Scholl', href: 'en/campaigns/scholl-iconic/', pic: true }, { src: 'w-copenhagen-studios-11', label: 'Copenhagen Studios', href: 'en/campaigns/copenhagen-studios/', pic: true }, { src: 'w-monano-schmuck-5', label: 'Monano', href: 'en/campaigns/monano-schmuck/', pic: true }, { src: 'w-appelrathcuepper-2', label: 'AppelrathCüpper', href: 'en/campaigns/appelrathcuepper/', pic: true }]}
  steps={[['Briefing', 'We talk about the brand, the product and what the pictures need to achieve.'], ['Concept and team', 'I am as involved as you want me to be: from concept and team to production.'], ['Production', 'In the studio, on location in Cologne or abroad. With a small team or a large one.'], ['Selection and retouching', 'You choose, I finish the pictures for every channel.']]}
  faq={[['How does working with brands and agencies work?', 'I am as involved as you want me to be: from concept and team to production. The more I take on before the shoot, the more it is reflected in the quote.'], ['How big does the team need to be?', 'Anything from tiny to huge. Because I set my own light, a small team is often enough. For almost every size I have productions and people I like working with.'], ['What does a campaign cost?', 'That depends on scope, team and usage. You get an individual quote.'], ['What can the pictures be used for?', 'We define that in the quote. Large advertising spaces and resale are licensed separately.'], ['Do you shoot outside Cologne?', 'Yes. I travel wherever the shoot takes us.']]}
  service="Campaign photography" offers={['Fashion campaigns', 'Jewellery photography', 'Editorials', 'Lookbooks']}
/>
