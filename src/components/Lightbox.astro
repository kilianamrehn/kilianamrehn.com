---
// Vollansicht für .ph-Elemente (data-full / data-video) und Videos, die erst im Bild starten.
// noZoom: Bilder bleiben klein (Flashes), nur die Videos werden gesteuert.
import type { Lang } from '../data/site';
interface Props { lang: Lang; noZoom?: boolean }
const { lang, noZoom = false } = Astro.props;
const en = lang === 'en';
---
{!noZoom && (
<div class="lb" data-lb hidden data-on={en ? 'Sound on' : 'Ton an'} data-off={en ? 'Sound off' : 'Ton aus'}>
  <div class="lb-stage" data-lb-stage></div>
  <button type="button" class="lb-prev" data-lb-prev aria-label={en ? 'Previous image' : 'Vorheriges Bild'}>‹</button>
  <button type="button" class="lb-next" data-lb-next aria-label={en ? 'Next image' : 'Nächstes Bild'}>›</button>
  <button type="button" class="lb-close" data-lb-close aria-label={en ? 'Close' : 'Schließen'}>×</button>
  <div class="lb-cap"><span data-lb-cap></span><span data-lb-num></span></div>
</div>
)}
<script>
  const io = new IntersectionObserver((es) => es.forEach((e) => {
    const v = e.target as HTMLVideoElement;
    if (e.isIntersecting) { if (!v.getAttribute('src') && v.dataset.src) v.src = v.dataset.src; v.play().catch(() => {}); } else v.pause();
  }), { threshold: 0.35 });
  document.querySelectorAll<HTMLVideoElement>('video[data-src], video[data-autoplay]').forEach((v) => io.observe(v));

  const lb = document.querySelector<HTMLElement>('[data-lb]');
  if (lb) {
    const stage = lb.querySelector<HTMLElement>('[data-lb-stage]')!;
    const cap = lb.querySelector<HTMLElement>('[data-lb-cap]')!;
    const numEl = lb.querySelector<HTMLElement>('[data-lb-num]')!;
    const mq = window.matchMedia('(max-width: 699px)');
    let list: HTMLElement[] = []; let cur = 0;
    const collect = () => {
      const L = mq.matches ? 'm' : 'd';
      list = [...document.querySelectorAll<HTMLElement>(`.lay.${L} .ph[data-full], .lay.${L} .ph[data-video], .jr .ph[data-full]`)].filter((el) => el.offsetParent !== null).sort((a, b) => {
        const ra = a.getBoundingClientRect(), rb = b.getBoundingClientRect();
        return Math.abs(ra.top - rb.top) > 40 ? ra.top - rb.top : ra.left - rb.left;
      });
    };
    const show = (k: number) => {
      cur = (k + list.length) % list.length; const el = list[cur]; stage.innerHTML = '';
      if (el.dataset.video) { const v = document.createElement('video'); v.src = el.dataset.video; v.muted = true; v.loop = true; v.autoplay = true; v.playsInline = true; v.setAttribute('aria-label', el.dataset.alt || ''); stage.appendChild(v); }
      else { const im = document.createElement('img'); im.src = el.dataset.full || ''; im.alt = el.dataset.alt || ''; stage.appendChild(im); }
      lb.querySelector('.lb-ton')?.remove();
      if (el.dataset.video && el.dataset.tonLb !== undefined) {
        document.querySelectorAll<HTMLVideoElement>('video').forEach((o) => { o.muted = true; });
        const b = document.createElement('button'); b.type = 'button'; b.className = 'lb-ton'; b.setAttribute('data-ton', '');
        b.dataset.on = lb.dataset.on; b.dataset.off = lb.dataset.off; b.textContent = b.dataset.on; b.setAttribute('aria-pressed', 'false');
        lb.appendChild(b); (window as any).__tonSync?.();
      }
      cap.textContent = el.dataset.cap || ''; numEl.textContent = `${cur + 1} / ${list.length}`;
    };
    const open = (el: HTMLElement) => { collect(); lb.hidden = false; document.documentElement.style.overflow = 'hidden'; show(Math.max(0, list.indexOf(el))); };
    const close = () => { lb.hidden = true; stage.innerHTML = ''; lb.querySelector('.lb-ton')?.remove(); (window as any).__tonSync?.(); document.documentElement.style.overflow = ''; };
    document.addEventListener('click', (e) => { const el = (e.target as HTMLElement).closest<HTMLElement>('.tisch .ph'); if (!el) return; const sec = el.closest<HTMLElement>('[data-href]'); if (sec?.dataset.href) { location.href = sec.dataset.href; return; } open(el); });
    document.addEventListener('keydown', (e) => {
      const el = (e.target as HTMLElement).closest?.<HTMLElement>('.tisch .ph');
      if (el && lb.hidden && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); open(el); return; }
      if (lb.hidden) return;
      if (e.key === 'Escape') close(); if (e.key === 'ArrowRight') show(cur + 1); if (e.key === 'ArrowLeft') show(cur - 1);
    });
    lb.querySelector('[data-lb-next]')!.addEventListener('click', (e) => { e.stopPropagation(); show(cur + 1); });
    lb.querySelector('[data-lb-prev]')!.addEventListener('click', (e) => { e.stopPropagation(); show(cur - 1); });
    lb.querySelector('[data-lb-close]')!.addEventListener('click', close);
    stage.addEventListener('click', (e) => { e.stopPropagation(); show(cur + 1); });
    lb.addEventListener('click', close);
    let sx = 0;
    lb.addEventListener('touchstart', (e) => { sx = e.touches[0].clientX; }, { passive: true });
    lb.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - sx; if (Math.abs(dx) > 50) show(cur + (dx < 0 ? 1 : -1)); });
  }
</script>
<style>
  .lb { position: fixed; inset: 0; z-index: 1000; background: rgba(12,10,9,0.95); display: flex; align-items: center; justify-content: center; }
  .lb[hidden] { display: none; }
  .lb-stage { display: contents; }
  .lb-stage :global(img), .lb-stage :global(video) { max-width: 90%; max-height: 82%; width: auto; height: auto; display: block; box-shadow: 0 30px 80px rgba(0,0,0,0.6); cursor: pointer; }
  .lb button { position: absolute; background: none; border: 0; color: var(--white); cursor: pointer; padding: 12px; font-family: var(--f-text); }
  .lb-prev, .lb-next { top: 50%; transform: translateY(-50%); font-size: clamp(34px, 5vw, 54px); }
  .lb-prev { left: clamp(4px, 2vw, 28px); } .lb-next { right: clamp(4px, 2vw, 28px); }
  .lb-close { right: clamp(8px, 2vw, 28px); top: clamp(8px, 2vw, 24px); font-size: 30px; }
  .lb-cap { position: absolute; left: clamp(16px, 3vw, 40px); bottom: clamp(14px, 3vw, 30px); right: 80px; display: flex; gap: 18px; align-items: baseline; color: var(--mute); font: 500 12px/1 var(--f-mono); letter-spacing: 0.18em; text-transform: uppercase; }
  .lb .lb-ton { left: clamp(8px, 2vw, 28px); top: clamp(12px, 2.4vw, 28px); font: 500 11px/1 var(--f-mono); letter-spacing: .18em; text-transform: uppercase; border: 1px solid rgba(255,255,255,.4); padding: 8px 10px; z-index: 2; }
  .lb .lb-ton[aria-pressed="true"] { border-color: #fff; }
  .lb-cap span:first-child { color: var(--white); }
</style>
