---
// Landingpage für einen Suchbegriff (Köln): ein Bild, eigener Text, Links in die passenden Teile der Seite.
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Pic from '../components/Pic.astro';
interface Props { title: string; description: string; h1: string; lead: string; img: { src: string; alt: string; pic?: boolean }; text: string[]; links: [string, string][]; service: string; offers: string[] }
const { title, description, h1, lead, img, text, links, service, offers } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const schema = { '@context': 'https://schema.org', '@type': 'Service', serviceType: service, provider: { '@id': 'https://kilianamrehn.com/#business' }, areaServed: 'Köln',
  hasOfferCatalog: { '@type': 'OfferCatalog', name: service, itemListElement: offers.map((n) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: n } })) } };
---
<Base title={title} description={description} schema={[schema]}>
<section class="wrap top">
  <h1 class="display">{h1}</h1>
  <p class="lead">{lead}</p>
</section>
<section class="wrap split">
  {img.pic ? <Pic name={img.src} alt={img.alt} sizes="(max-width: 900px) 100vw, 45vw" class="pic" /> : <Img src={img.src} alt={img.alt} sizes="(max-width: 900px) 100vw, 45vw" class="pic" />}
  <div class="text">
    {text.map((t) => <p>{t}</p>)}
    <h2 class="mono mute">Mehr dazu</h2>
    <ul class="mono">{links.map(([l, h]) => <li><a href={base + h}>{l} →</a></li>)}</ul>
    <p class="cta"><a class="u" href={base + 'ueber/#kontakt'}>Schreib mir, was du vorhast.</a></p>
  </div>
</section>
</Base>
<style>
  .top { padding-top: 32px; padding-bottom: 64px; }
  .top h1 { font-size: clamp(34px, 9.4vw, 120px); color: var(--white); overflow-wrap: anywhere; }
  .lead { max-width: 720px; margin-top: 24px; font-size: clamp(18px, 1.6vw, 22px); color: var(--mute2); }
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; padding-bottom: 140px; align-items: start; }
  .split :global(.pic) { width: 100%; height: auto; display: block; }
  .text { display: flex; flex-direction: column; gap: 18px; color: var(--mute2); font-size: 18px; }
  .text h2 { font-weight: 400; margin-top: 24px; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; color: var(--white); }
  .u { color: var(--white); text-decoration: underline; text-underline-offset: 4px; }
  .cta { margin-top: 12px; font-size: 22px; }
  @media (max-width: 900px) { .split { grid-template-columns: 1fr; } }
</style>
