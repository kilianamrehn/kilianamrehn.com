---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import { artists, more } from '../data/artists';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const all = [...artists, ...more];
const gallery = {
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Künstlerporträts Köln',
  about: all.map((a) => ({ '@type': 'Person', name: a.name })), author: { '@id': 'https://kilianamrehn.com/#person' },
};
---
<Base title="Künstlerporträts & Musikerfotos Köln · Artists · Kilian Amrehn" description="Künstlerporträts aus Köln: Morley, Bianca Berding, Lea Mende, Pia Stutzenstein und weitere. Musikerfotos, Pressefotos, EP-Cover und Schauspielporträts von Kilian Amrehn." schema={[gallery]}>
<section class="wrap head">
  <h1 class="display">Artists<span class="visually-hidden"> · Künstlerporträts Köln</span></h1>
  <p class="mute">Künstlerporträts und Musikerfotos aus Köln. Pro Artist zwei oder drei Bilder, die ich selbst ausgesucht habe.</p>
</section>
<nav class="index" aria-label="Artists">
  <div class="wrap index-in">{all.map((a, i) => <a href={`#${a.id}`}><span class="mono">{String(i + 1).padStart(2, '0')}</span>{a.name}</a>)}</div>
</nav>

{artists.map((a, i) => (
  <article id={a.id} class="artist">
    <header class="wrap a-head">
      <h2><span class="mono num">{String(i + 1).padStart(2, '0')}</span><span class="display">{a.name}</span></h2>
      <span class="mono" style={`color:${a.color}`}>{a.meta}</span>
    </header>
    {a.layout === 'pairfull' && (<>
      <div class="grid g11 tall">{a.pics.slice(0, 2).map((p) => <Img src={p.src} alt={p.alt} pos={p.pos} sizes="(max-width: 720px) 100vw, 50vw" />)}</div>
      <div class="grid g1 wide"><Img src={a.pics[2].src} alt={a.pics[2].alt} pos={a.pics[2].pos} /></div>
    </>)}
    {a.layout === 'pair23' && <div class="grid g23 tall">{a.pics.map((p, j) => <Img src={p.src} alt={p.alt} pos={p.pos} sizes={j === 0 ? '(max-width: 720px) 100vw, 40vw' : '(max-width: 720px) 100vw, 60vw'} />)}</div>}
    {a.layout === 'pair11' && <div class="grid g11 xtall">{a.pics.map((p) => <Img src={p.src} alt={p.alt} pos={p.pos} sizes="(max-width: 720px) 100vw, 50vw" />)}</div>}
    {a.layout === 'trio' && <div class="grid g111 mid">{a.pics.map((p) => <Img src={p.src} alt={p.alt} pos={p.pos} sizes="(max-width: 720px) 100vw, 33vw" />)}</div>}
    {a.layout === 'full' && <div class="grid g1 wide">{a.pics.map((p) => <Img src={p.src} alt={p.alt} pos={p.pos} />)}</div>}
    {a.line && <p class="runon wrap line" set:html={a.line} />}
  </article>
))}

<section class="more">
  <div class="wrap mono mute more-head">{String(artists.length + 1).padStart(2, '0')} bis {String(all.length).padStart(2, '0')} · Außerdem vor der Kamera</div>
  <div class="grid g111">
    {more.map((a) => (
      <div id={a.id} class="more-item">
        <Img src={a.pics[0].src} alt={a.pics[0].alt} pos={a.pics[0].pos} sizes="(max-width: 720px) 100vw, 33vw" />
        <span class="more-name"><span class="display">{a.name}</span><span class="mono mute">{a.meta}</span></span>
      </div>
    ))}
  </div>
</section>
<section class="wrap outro">
  <p class="runon">Hier fehlt noch ein Name. <a class="white" href={base + 'ueber/#kontakt'}>Schreib mir →</a></p>
</section>
</Base>
<style>
  .head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px; padding-top: 32px; padding-bottom: 24px; }
  .head h1 { font-size: clamp(80px, 11.7vw, 168px); line-height: .86; }
  .head p { max-width: 340px; font-size: 15px; }
  .index { position: sticky; top: 0; z-index: 5; background: rgba(7,6,5,.92); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .index-in { display: flex; gap: 32px; overflow-x: auto; padding-top: 16px; padding-bottom: 16px; font-family: var(--f-display); font-weight: 500; font-size: 17px; letter-spacing: -.01em; white-space: nowrap; scrollbar-width: none; }
  .index-in a { display: flex; gap: 8px; align-items: baseline; }
  .index-in .mono { font-size: 11px; color: #5c544a; }
  .artist { padding-top: clamp(90px, 10vw, 140px); scroll-margin-top: 40px; }
  .a-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 12px 16px; padding-bottom: 28px; }
  .a-head h2 { display: flex; gap: 20px; align-items: baseline; font-weight: inherit; }
  .a-head .display { font-size: clamp(54px, 7.8vw, 112px); color: var(--white); }
  .num { color: #5c544a; }
  .grid { display: grid; gap: 6px; overflow: hidden; }
  .grid :global(picture) { display: block; height: 100%; min-height: 0; }
  .grid :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .g1 { grid-template-columns: 1fr; } .g11 { grid-template-columns: 1fr 1fr; } .g23 { grid-template-columns: 2fr 3fr; } .g111 { grid-template-columns: 1fr 1fr 1fr; }
  .tall { height: clamp(520px, 60vw, 900px); } .xtall { height: clamp(560px, 70vw, 1000px); } .mid { height: clamp(460px, 54vw, 780px); } .wide { height: clamp(380px, 62vw, 940px); margin-top: 6px; }
  .line { padding-top: 40px; font-size: clamp(28px, 3.6vw, 52px); color: var(--dim); }
  .more { padding-top: clamp(110px, 11vw, 160px); }
  .more-head { padding-bottom: 28px; }
  .more-item { display: flex; flex-direction: column; gap: 14px; scroll-margin-top: 80px; }
  .more-item :global(img) { height: clamp(420px, 43vw, 620px); }
  .more-name { padding: 0 16px; display: flex; justify-content: space-between; align-items: baseline; }
  .more-name .display { font-size: 40px; line-height: 1; }
  .outro { padding-top: 160px; padding-bottom: 160px; }
  .outro .runon { font-size: clamp(36px, 5vw, 72px); color: var(--dim); }
  @media (max-width: 720px) {
    .g11, .g23, .g111 { grid-template-columns: 1fr; }
    .tall, .xtall, .mid { height: auto; }
    .tall :global(img), .xtall :global(img), .mid :global(img) { height: 125vw; }
    .tall :global(picture), .xtall :global(picture), .mid :global(picture) { height: auto; }
    .wide { height: 90vw; }
  }
</style>
