---
// Arbeiten: Kampagnen und freie Strecken. Farbleiste oben, jede Arbeit auf einem Bogen in ihrer Farbe.
import { altOf as altText } from '../data/alts';
import Base from '../layouts/Base.astro';
import Tisch from '../components/Tisch.astro';
import Lightbox from '../components/Lightbox.astro';
import idx from '../data/tisch/arbeiten-index.json';
import { routes, campaignPath, type Lang } from '../data/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const en = lang === 'en';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const T = en
  ? { title: 'Work · Campaign, Fashion & Editorial Photography Cologne', desc: "Campaigns and personal series by Kilian Amrehn, Cologne: Scholl, Copenhagen Studios, P&C x Ellesse, PNTS, AppelrathCüpper, Bundesliga, New Icons' Club.", h1: 'Work', sub: 'Campaigns & personal series', view: 'View →', book: 'My campaign book' }
  : { title: 'Arbeiten · Kampagnen, Mode & Editorial aus Köln', desc: "Kampagnen und freie Strecken von Kilian Amrehn, Köln: Scholl, Copenhagen Studios, P&C x Ellesse, PNTS, AppelrathCüpper, Bundesliga, New Icons' Club.", h1: 'Arbeiten', sub: 'Kampagnen & freie Strecken', view: 'Ansehen →', book: 'Mein Kampagnenbuch' };
const list = idx as any[];
const lightOf = (hex: string) => { const n = parseInt(hex.slice(1), 16); return (0.299 * Math.floor(n / 65536) + 0.587 * (Math.floor(n / 256) % 256) + 0.114 * (n % 256)) / 255 > 0.6; };
const inkVars = (hex: string) => lightOf(hex) ? ';--tx:#122228;--tx2:rgba(18,34,40,.72);--tx3:rgba(18,34,40,.5)' : '';
---
<Base lang={lang} image="/media/og/arbeiten.jpg" alternate={routes.campaigns[en ? 'de' : 'en']} title={T.title} description={T.desc}>
<section class="wrap ar-head">
  <h1 class="mono kick">{T.h1}</h1>
  <span class="mono sub">{T.sub}</span>
</section>
<nav id="index" class="wrap toc mono" aria-label={T.h1}>
  {list.map((k) => <a href={`#${k.slug}`}>{k.title}</a>)}
</nav>
<a class="ar-idx mono" href="#index" hidden>Index ↑</a>
{list.map((k) => (
  <article id={k.slug} class="ar">
    <a class="ar-top" href={base + campaignPath(k.slug, lang)} style={`background:${k.bg}${inkVars(k.bg)}`}>
      <span class="wrap ar-t">
        <span class="display ar-name">{k.title}</span>
        <span class="mono ar-meta">{en ? k.kindEn : k.kind}</span>
        <span class="mono ar-cta">{T.view}</span>
      </span>
    </a>
    <Tisch sheets={[{ bg: k.bg, d: k.d, m: k.m, href: base + campaignPath(k.slug, lang) }]} lang={lang} alt={(n, i) => altText(n, en, `${k.title}, ${en ? k.kindEn : k.kind}, ${en ? 'photographed by' : 'fotografiert von'} Kilian Amrehn`)} />
  </article>
))}
<div class="wrap ar-book"><a class="ar-btn" href={base + 'media/kilian-amrehn-buch-kampagnen.pdf'} target="_blank" rel="noopener">{T.book} <span>↗</span></a></div>
{!en && <p class="wrap mono ar-seo"><a href={base + 'kampagnenfotografie-koeln/'}>Kampagnenfotografie Köln →</a></p>}
<Lightbox lang={lang} />
<script>
  const toc = document.getElementById('index');
  const btn = document.querySelector<HTMLElement>('.ar-idx');
  if (toc && btn) new IntersectionObserver(([e]) => { btn.hidden = e.isIntersecting || e.boundingClientRect.top > 0; }).observe(toc);
</script>
</Base>
<style>
  .ar-head { padding-top: 32px; padding-bottom: 32px; display: flex; flex-wrap: wrap; align-items: baseline; gap: 12px 32px; }
  .kick { font: 500 12px/1 var(--f-mono); letter-spacing: .24em; text-transform: uppercase; color: var(--paper); margin: 0; }
  .sub { color: var(--mute); letter-spacing: .16em; text-transform: uppercase; font-size: 12px; }
  /* Inhaltsverzeichnis: ruhige Textliste, eine Farbe */
  .toc { columns: 3; column-gap: 32px; padding-top: 18px; padding-bottom: 18px; border-top: 1px solid var(--num); border-bottom: 1px solid var(--num); margin-bottom: 8px; }
  .toc a { display: block; padding: 9px 0; font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--paper); text-decoration: none; break-inside: avoid; }
  .toc a:hover, .toc a:focus-visible { color: var(--accent); }
  @media (max-width: 900px) { .toc { columns: 2; } }
  @media (max-width: 420px) { .toc { columns: 1; } }
  .ar-idx { position: fixed; right: calc(var(--pad) + env(safe-area-inset-right, 0px)); bottom: calc(20px + env(safe-area-inset-bottom, 0px)); z-index: 800; padding: 10px 14px; border-radius: 999px; background: var(--ink); color: var(--paper); border: 1px solid var(--num); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; text-decoration: none; }
  .ar-idx:hover, .ar-idx:focus-visible { border-color: var(--paper); }
  .ar { scroll-margin-top: 64px; position: relative; }
  .ar-top { display: block; position: relative; z-index: 50; color: var(--tx, var(--white)); text-decoration: none; }
  .ar-t { display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px 28px; padding-top: 44px; padding-bottom: 8px; }
  .ar-name { font-size: clamp(40px, 6vw, 96px); line-height: .9; }
  .ar-meta { color: var(--tx2, rgba(235,211,162,.75)); letter-spacing: .14em; text-transform: uppercase; font-size: 12px; }
  .ar-cta { margin-left: auto; padding: 8px 14px; border: 1px solid var(--tx2, rgba(235,211,162,.6)); border-radius: 999px; font-size: 12px; }
  .ar :global(.sheet .band) { top: 0 !important; box-shadow: none !important; transform: none !important; }
  .ar :global(.ph) { cursor: pointer; }
  .ar-book { padding-top: clamp(56px, 8vw, 96px); }
  .ar-btn { display: inline-flex; align-items: center; gap: 14px; padding: clamp(14px, 3vw, 22px) clamp(20px, 4vw, 30px); border-radius: 999px; font-family: var(--f-display); font-weight: 500; font-size: clamp(18px, 4.6vw, 26px); letter-spacing: -0.02em; text-decoration: none; line-height: 1.1; background: var(--accent); color: var(--ink); }
  .ar-btn:hover { color: var(--ink); filter: brightness(1.06); }
  .ar-seo { padding-top: 48px; padding-bottom: 8px; font-size: 13px; letter-spacing: .12em; text-transform: uppercase; }
  .ar-seo a { color: var(--mute); }
</style>
